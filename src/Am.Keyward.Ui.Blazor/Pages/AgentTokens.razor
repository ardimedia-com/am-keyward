@page "/amkeyward/agent-tokens"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@using Am.Keyward.Core.Domain.Agent
@implements IAsyncDisposable
@inject IAgentTokenService AgentTokenService
@inject IRevealRequestService RevealRequests
@inject IVaultService VaultService
@inject IProjectService ProjectService
@inject ICurrentUser CurrentUser
@inject IKeywardWorkspaceContext Workspace
@inject IStringLocalizer<SharedResource> Loc
@inject KeywardUiOptions KeywardOptions
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>@KeywardOptions.ProductName</PageTitle>

@* The signed-in user's own agent tokens: an AI assistant (e.g. Claude Code) presents one to work with vault
   entries as this user — only on the vaults and with the permissions picked here — and, for a user who may manage
   the software side, to set up applications (write-only, never app tokens). The plaintext is shown once. *@
<KeywardUi>
    <div class="page-header">
        <h1>@Loc["Page.AgentTokens.Title"]</h1>
        <p>@Loc["Page.AgentTokens.Desc"]</p>
    </div>

    @if (noAccount)
    {
        <KeywardNoAccount />
    }
    else if (tokens is null || openVaults is null)
    {
        <p class="muted">@Loc["Common.Loading"]</p>
    }
    else
    {
        <div class="agent-tokens">
            @if (issuedToken is not null)
            {
                <div class="notice notice-reveal" role="status">
                    @Loc["AgentTokens.New"]
                    <div class="issued-token">
                        <code>@issuedToken</code>
                        <button @ref="issuedCopyButton" class="icon-btn" title="@Loc["Common.Copy"]" @onclick="CopyIssuedAsync"><KeywardIcon Name="@(issuedCopied ? "check" : "copy")" Size="15" /></button>
                    </div>
                    @* Right where the token is copied: everything to run on the agent's computer, as one PowerShell block.
                       «setup» asks for the token (hidden input), so it never lands in the shell history. *@
                    <p class="issued-next">@Loc["AgentTokens.Usage.Next"]</p>
                    @OsSwitch
                    @DotNetPrerequisite
                    <div class="usage-script">
                        <pre><code>@SetupScript</code></pre>
                        <button class="icon-btn" title="@Loc["Common.Copy"]" @onclick="() => CopyCommandAsync(SetupScript)"><KeywardIcon Name="@(copiedCommand == SetupScript ? "check" : "copy")" Size="15" /></button>
                    </div>
                </div>
            }

            @* Pending reveal requests of this user's agents. Only this user can decide them, and they expire within
               minutes, so the list refreshes itself while the page is open. The reason is the agent's own text:
               Razor encodes it, so it is shown as plain text. *@
            @if (pending is { Count: > 0 })
            {
                <section class="card reveal-requests" aria-live="polite">
                    <h3>@Loc["AgentTokens.Reveal.Title"] (@pending.Count)</h3>
                    <p class="muted">@Loc["AgentTokens.Reveal.Desc"]</p>
                    @foreach (var request in pending)
                    {
                        <div class="reveal-row">
                            <div class="token-main">
                                <KeywardIcon Name="eye" Size="17" />
                                @* The person can also open the entry and copy the value there instead of approving. *@
                                <a class="token-name" href="@KeywardRoutes.EntryLinkFor(Base62Guid.Encode(request.ItemPublicId))">@request.ItemName</a>
                                <span class="badge">@FieldLabel(request.Field)</span>
                            </div>
                            <div class="token-facts muted">
                                <span>@request.VaultName</span>
                                <span>@Loc["AgentTokens.Reveal.By", request.TokenName]</span>
                                <span>@Loc["AgentTokens.Reveal.Until"] <LocalTime Utc="request.ExpiresAt" /></span>
                            </div>
                            <blockquote class="reveal-reason">@request.Reason</blockquote>
                            <div class="token-actions">
                                <button class="btn-sm" @onclick="() => ApproveAsync(request.Id)" disabled="@busy">@Loc["AgentTokens.Reveal.Approve"]</button>
                                <button class="btn-danger btn-sm" @onclick="() => RejectAsync(request.Id)" disabled="@busy">@Loc["AgentTokens.Reveal.Reject"]</button>
                            </div>
                        </div>
                    }
                </section>
            }

            <section class="card">
                <h3 class="section-heading">
                    <button type="button" class="section-toggle" aria-expanded="@(showTokens ? "true" : "false")" @onclick="() => showTokens = !showTokens">
                        <KeywardIcon Name="@(showTokens ? "chevron-down" : "chevron-right")" Size="16" />@Loc["AgentTokens.Existing"] (@tokens.Count)
                    </button>
                </h3>
                @if (showTokens && tokens.Count == 0)
                {
                    <p class="muted">@Loc["AgentTokens.None"]</p>
                }
                else if (showTokens)
                {
                    <div class="list-rows">
                        @foreach (var token in tokens)
                        {
                            <div class="token-row">
                                <div class="token-main">
                                    <KeywardIcon Name="key" Size="17" />
                                    <span class="token-name">@token.Name</span>
                                    <span class="badge @StatusClass(token)">@StatusLabel(token)</span>
                                </div>
                                @* One labelled line per fact, indented under the token name. *@
                                <dl class="token-facts muted">
                                    @if (token.AllAgentVaults || token.VaultIds.Count > 0)
                                    {
                                        <dt>@Loc["AgentTokens.Vaults"]</dt>
                                        <dd>@(token.AllAgentVaults ? Loc["AgentTokens.AllVaults"] : string.Join(", ", token.VaultIds.Select(VaultName)))</dd>
                                        <dt>@Loc["AgentTokens.Facts.Permissions"]</dt>
                                        <dd>@string.Join(", ", OfferedScopes.Where(s => token.Scopes.HasFlag(s)).Select(ScopeLabel))</dd>
                                    }
                                    @if (token.Scopes.HasFlag(AgentScopes.ManageApplications))
                                    {
                                        <dt>@Loc["AgentTokens.Applications"]</dt>
                                        <dd>@ApplicationsFact(token)</dd>
                                    }
                                    <dt>@Loc["AgentTokens.Facts.Networks"]</dt>
                                    <dd>@(string.IsNullOrEmpty(token.AllowedNetworks) ? Loc["AgentTokens.AnyNetwork"] : token.AllowedNetworks)</dd>
                                    <dt>@Loc["AgentTokens.Expires"]</dt>
                                    <dd><LocalTime Utc="token.ExpiresAt" /></dd>
                                </dl>
                                @if (!token.IsActive && extendTokenId != token.Id)
                                {
                                    @* A token that no longer works can leave the list; a working one is revoked first. *@
                                    <div class="token-actions">
                                        @if (confirmDeleteId == token.Id)
                                        {
                                            <span>@Loc["AgentTokens.ConfirmDelete", token.Name]</span>
                                            <button class="btn-danger btn-sm" @onclick="() => DeleteAsync(token.Id)" disabled="@busy">@Loc["Common.Yes"]</button>
                                            <button class="btn-ghost btn-sm" @onclick="() => confirmDeleteId = null">@Loc["Common.Cancel"]</button>
                                        }
                                        else
                                        {
                                            @if (token.RevokedAt is null)
                                            {
                                                <button class="btn-ghost btn-sm" @onclick="() => StartExtend(token.Id)" disabled="@busy">@Loc["AgentTokens.Extend"]</button>
                                            }
                                            <button class="btn-danger btn-sm" @onclick="() => confirmDeleteId = token.Id" disabled="@busy">@Loc["Common.Delete"]</button>
                                        }
                                    </div>
                                }
                                @if (token.RevokedAt is null && (token.IsActive || extendTokenId == token.Id))
                                {
                                    <div class="token-actions">
                                        @if (confirmRevokeId == token.Id)
                                        {
                                            <span>@Loc["AgentTokens.ConfirmRevoke", token.Name]</span>
                                            <button class="btn-danger btn-sm" @onclick="() => RevokeAsync(token.Id)" disabled="@busy">@Loc["Common.Yes"]</button>
                                            <button class="btn-ghost btn-sm" @onclick="() => confirmRevokeId = null">@Loc["Common.Cancel"]</button>
                                        }
                                        else if (extendTokenId == token.Id)
                                        {
                                            @* A new validity on the same value: the computer keeps working without a new setup. *@
                                            <label class="extend-days">
                                                <span>@Loc["AgentTokens.Extend.Days"]</span>
                                                <input type="number" min="1" max="@MaxDays" @bind="extendDays" />
                                            </label>
                                            <button class="btn-sm" @onclick="() => ExtendAsync(token.Id)" disabled="@(busy || extendDays is < 1 || extendDays > MaxDays)">@Loc["AgentTokens.Extend"]</button>
                                            <button class="btn-ghost btn-sm" @onclick="() => extendTokenId = null">@Loc["Common.Cancel"]</button>
                                        }
                                        else
                                        {
                                            <button class="btn-ghost btn-sm" @onclick="() => StartEditAsync(token)" disabled="@busy">@Loc["Common.Edit"]</button>
                                            <button class="btn-ghost btn-sm" @onclick="() => StartExtend(token.Id)" disabled="@busy">@Loc["AgentTokens.Extend"]</button>
                                            <button class="btn-ghost btn-sm" @onclick="() => RotateAsync(token.Id)" disabled="@busy">@Loc["AgentTokens.Rotate"]</button>
                                            <button class="btn-danger btn-sm" @onclick="() => confirmRevokeId = token.Id" disabled="@busy">@Loc["AgentTokens.Revoke"]</button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </section>

            @* Administrators see every token of the organisation and can revoke one (a lost computer, someone who
               left) — never change or issue one for someone else. *@
            @if (canAdminister && adminTokens is not null)
            {
                <section class="card">
                    <h3 class="section-heading">
                        <button type="button" class="section-toggle" aria-expanded="@(showAdmin ? "true" : "false")" @onclick="() => showAdmin = !showAdmin">
                            <KeywardIcon Name="@(showAdmin ? "chevron-down" : "chevron-right")" Size="16" />@Loc["AgentTokens.Admin.Title"] (@adminTokens.Count)
                        </button>
                    </h3>
                    @if (showAdmin)
                    {
                        <p class="muted">@Loc["AgentTokens.Admin.Desc"]</p>
                        <div class="list-rows">
                            @foreach (var entry in adminTokens)
                            {
                                <div class="token-row">
                                    <div class="token-main">
                                        <KeywardIcon Name="key" Size="17" />
                                        <span class="token-name">@entry.Token.Name</span>
                                        <span class="badge @StatusClass(entry.Token)">@StatusLabel(entry.Token)</span>
                                    </div>
                                    <dl class="token-facts muted">
                                        <dt>@Loc["AgentTokens.Admin.Owner"]</dt>
                                        <dd>@entry.OwnerName</dd>
                                        <dt>@Loc["AgentTokens.Facts.Permissions"]</dt>
                                        <dd>@string.Join(", ", AllScopes.Where(sc => entry.Token.Scopes.HasFlag(sc)).Select(ScopeLabel))</dd>
                                        <dt>@Loc["AgentTokens.Expires"]</dt>
                                        <dd><LocalTime Utc="entry.Token.ExpiresAt" /></dd>
                                    </dl>
                                    @if (entry.Token.RevokedAt is null)
                                    {
                                        <div class="token-actions">
                                            @if (adminConfirmRevokeId == entry.Token.Id)
                                            {
                                                <span>@Loc["AgentTokens.ConfirmRevoke", entry.Token.Name]</span>
                                                <button class="btn-danger btn-sm" @onclick="() => AdminRevokeAsync(entry.Token.Id)" disabled="@busy">@Loc["Common.Yes"]</button>
                                                <button class="btn-ghost btn-sm" @onclick="() => adminConfirmRevokeId = null">@Loc["Common.Cancel"]</button>
                                            }
                                            else
                                            {
                                                <button class="btn-danger btn-sm" @onclick="() => adminConfirmRevokeId = entry.Token.Id" disabled="@busy">@Loc["AgentTokens.Revoke"]</button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </section>
            }

            @* What a token is for and how it reaches the assistant — the steps are the same on every computer; only the
               KEYWARD address differs, so it is filled in. *@
            <section class="card usage" id="usage">
                <h3 class="section-heading">
                    <button type="button" class="section-toggle" aria-expanded="@(showUsage ? "true" : "false")" @onclick="() => showUsage = !showUsage">
                        <KeywardIcon Name="@(showUsage ? "chevron-down" : "chevron-right")" Size="16" />@Loc["AgentTokens.Usage.Title"]
                    </button>
                </h3>
                @if (showUsage)
                {
                    <p class="muted">@Loc["AgentTokens.Usage.Intro"]</p>
                    <p class="muted">@Loc["AgentTokens.Usage.Scope"]</p>
                    @OsSwitch
                    @DotNetPrerequisite
                    @StepList(UsageSteps)
                }
            </section>

            @* The way back: what was set up on a computer, removed in reverse, and the token revoked and deleted here. *@
            <section class="card usage" id="uninstall">
                <h3 class="section-heading">
                    <button type="button" class="section-toggle" aria-expanded="@(showUninstall ? "true" : "false")" @onclick="() => showUninstall = !showUninstall">
                        <KeywardIcon Name="@(showUninstall ? "chevron-down" : "chevron-right")" Size="16" />@Loc["AgentTokens.Uninstall.Title"]
                    </button>
                </h3>
                @if (showUninstall)
                {
                    <p class="muted">@Loc["AgentTokens.Uninstall.Intro"]</p>
                    @OsSwitch
                    @StepList(UninstallSteps)
                    <p class="muted">@Loc["AgentTokens.Uninstall.Lost"]</p>
                }
            </section>

            <section class="card" id="token-form">
                <h3 class="section-heading">
                    <button type="button" class="section-toggle" aria-expanded="@(showForm ? "true" : "false")" @onclick="() => showForm = !showForm">
                        <KeywardIcon Name="@(showForm ? "chevron-down" : "chevron-right")" Size="16" />@(editingTokenId is null ? Loc["AgentTokens.Issue.Title"] : Loc["AgentTokens.Edit.Title", name])
                    </button>
                </h3>
                @if (showForm && openVaults.Count == 0 && !canManageApplications)
                {
                    <p class="muted">@Loc["AgentTokens.NoVaults"]</p>
                }
                else if (showForm)
                {
                    <div class="issue-form">
                        <label class="field">
                            <span>@Loc["AgentTokens.Name"]</span>
                            <input @ref="nameInput" @bind="name" @bind:event="oninput" maxlength="256" />
                        </label>
                        <p class="muted issue-hint">@Loc["AgentTokens.Issue.Hint"]</p>

                        @if (openVaults.Count == 0)
                        {
                            <p class="muted">@Loc["AgentTokens.NoVaults"]</p>
                        }
                        else
                        {
                            <fieldset class="field">
                                <legend>@Loc["AgentTokens.Vaults"]</legend>
                                <label class="choice">
                                    <input type="checkbox" @bind="allAgentVaults" />
                                    @Loc["AgentTokens.AllVaults"]
                                </label>
                                @if (!allAgentVaults)
                                {
                                    @foreach (var vault in openVaults)
                                    {
                                        <label class="choice">
                                            <input type="checkbox" checked="@selectedVaults.Contains(vault.Id)" @onchange="e => Toggle(selectedVaults, vault.Id, e)" />
                                            @vault.Name
                                        </label>
                                    }
                                }

                                @* The vault permissions apply to these vaults only — hence indented under them. *@
                                <p class="choice-group-title">@Loc["AgentTokens.Scopes"]</p>
                                <div class="choice-group">
                                    @foreach (var scope in OfferedScopes)
                                    {
                                        <label class="choice">
                                            <input type="checkbox" checked="@selectedScopes.HasFlag(scope)" @onchange="e => ToggleScope(scope, e)" />
                                            @ScopeLabel(scope)
                                        </label>
                                    }
                                </div>
                            </fieldset>
                        }

                        @* Offered only to a user who may manage the software side; unticked by default and separate from
                           the vault permissions. *@
                        @if (canManageApplications)
                        {
                            <fieldset class="field">
                                <legend>@Loc["AgentTokens.Applications"]</legend>
                                <label class="choice choice-described">
                                    <input type="checkbox" checked="@ManagesApplications" @onchange="e => ToggleScope(AgentScopes.ManageApplications, e)" />
                                    <span class="choice-text">
                                        <span>@ScopeLabel(AgentScopes.ManageApplications)</span>
                                        <span class="muted">@Loc["AgentTokens.Applications.Desc"]</span>
                                    </span>
                                </label>
                                @if (ManagesApplications)
                                {
                                    <div class="choice-group">
                                        <label class="choice">
                                            <input type="checkbox" @bind="allApplications" />
                                            @Loc["AgentTokens.AllApplications"]
                                        </label>
                                        @if (!allApplications)
                                        {
                                            @foreach (var application in applications!)
                                            {
                                                <label class="choice">
                                                    <input type="checkbox" checked="@selectedApplications.Contains(application.Id)" @onchange="e => Toggle(selectedApplications, application.Id, e)" />
                                                    @application.Name
                                                </label>
                                            }
                                        }
                                        <label class="choice">
                                            <input type="checkbox" @bind="mayCreateApplications" />
                                            @Loc["AgentTokens.Applications.CreateNew"]
                                        </label>
                                    </div>
                                }
                            </fieldset>
                        }

                        <div class="field-pair @(editingTokenId is null ? "" : "single")">
                            @* The validity is set at issue; «New value» starts a fresh one. *@
                            @if (editingTokenId is null)
                            {
                                <label class="field">
                                    <span>@Loc["AgentTokens.Days"]</span>
                                    <input type="number" min="1" max="@MaxDays" @bind="days" />
                                </label>
                            }
                            <label class="field">
                                <span>@Loc["AgentTokens.Networks"]</span>
                                <input @bind="networks" placeholder="10.1.0.0/23, 192.168.113.0/24" />
                                <span class="muted field-help">@Loc["AgentTokens.Networks.Help"]</span>
                            </label>
                        </div>

                        <div class="form-actions">
                            @if (editingTokenId is null)
                            {
                                <button @onclick="IssueAsync" disabled="@(busy || !CanIssue)"><KeywardIcon Name="plus" />@Loc["AgentTokens.Issue.Action"]</button>
                            }
                            else
                            {
                                <button @onclick="SaveEditAsync" disabled="@(busy || !CanIssue)">@Loc["Common.Save"]</button>
                                <button class="btn-ghost" @onclick="CancelEdit" disabled="@busy">@Loc["Common.Cancel"]</button>
                            }
                        </div>
                    </div>
                }
            </section>

            @if (status is not null)
            {
                <div class="notice @(status.Value.IsError ? "notice-error" : "")" role="@(status.Value.IsError ? "alert" : "status")">@status.Value.Text</div>
            }
        </div>
    }
</KeywardUi>

@code {
    // Numbered steps, each with its copyable command (or text only): setup in «How to use» and inside the notice of a
    // freshly issued token, and the way back in «Remove again».
    private RenderFragment StepList(IReadOnlyList<(string Label, string? Command)> steps) => __builder =>
    {
        <ol class="usage-steps">
            @foreach (var (label, command) in steps)
            {
                <li>
                    <span>@label</span>
                    @if (command is not null)
                    {
                        <div class="usage-command">
                            <code>@command</code>
                            <button class="icon-btn" title="@Loc["Common.Copy"]" @onclick="() => CopyCommandAsync(command)"><KeywardIcon Name="@(copiedCommand == command ? "check" : "copy")" Size="15" /></button>
                        </div>
                    }
                </li>
            }
        </ol>
    };

    // The commands for Windows (PowerShell) or macOS (Terminal); one switch for every place they appear.
    private RenderFragment OsSwitch => __builder =>
    {
        <div class="os-switch" role="group" aria-label="@Loc["AgentTokens.Usage.Os"]">
            <button type="button" class="@(mac ? null : "active")" aria-pressed="@(mac ? "false" : "true")" @onclick="() => mac = false">Windows</button>
            <button type="button" class="@(mac ? "active" : null)" aria-pressed="@(mac ? "true" : "false")" @onclick="() => mac = true">macOS</button>
        </div>
    };

    // The .NET SDK the program installs with; kept out of the copy-all block, because a new window is needed after it.
    private RenderFragment DotNetPrerequisite => __builder =>
    {
        <div class="usage-prereq">
            <span>@Loc["AgentTokens.Usage.DotNet"]</span>
            <div class="usage-command">
                <code>@DotNetCommand</code>
                <button class="icon-btn" title="@Loc["Common.Copy"]" @onclick="() => CopyCommandAsync(DotNetCommand)"><KeywardIcon Name="@(copiedCommand == DotNetCommand ? "check" : "copy")" Size="15" /></button>
            </div>
            @if (mac)
            {
                <span class="muted">@Loc["AgentTokens.Usage.DotNet.NoBrew"]</span>
            }
            <span class="muted">@Loc["AgentTokens.Usage.NoDotNet"] <a href="@NoDotNetGuide" target="_blank" rel="noopener">@Loc["AgentTokens.Usage.NoDotNet.Link"]</a></span>
        </div>
    };

    private static readonly AgentScopes[] OfferedScopes = [AgentScopes.VaultList, AgentScopes.VaultRead, AgentScopes.VaultWrite, AgentScopes.VaultReveal];

    private static readonly AgentScopes[] AllScopes = [.. OfferedScopes, AgentScopes.ManageApplications];

    private static readonly TimeSpan PendingRefresh = TimeSpan.FromSeconds(5);

    private static readonly int MaxDays = (int)AgentTokenLifetime.Maximum.TotalDays;

    private bool noAccount;
    private Guid actorUserId;
    private Guid tenantId;

    private IReadOnlyList<AgentTokenSummary>? tokens;
    private IReadOnlyList<PendingRevealRequest>? pending;
    private PeriodicTimer? refreshTimer;
    private IReadOnlyList<VaultSummary>? openVaults;
    private Dictionary<Guid, string> vaultNames = [];
    private bool canManageApplications;
    private IReadOnlyList<ProjectInfo>? applications;

    private string name = "";
    private readonly HashSet<Guid> selectedVaults = [];
    private readonly HashSet<Guid> selectedApplications = [];
    private bool mayCreateApplications;
    private AgentScopes selectedScopes = AgentScopes.VaultList | AgentScopes.VaultWrite;
    private int days = (int)AgentTokenLifetime.Default.TotalDays;
    private string networks = "";

    private string? issuedToken;
    private bool issuedCopied;
    private string? copiedCommand;

    // The address the MCP server talks to: the configured public address, else the one this page was opened on.
    private string ServiceUri => (KeywardOptions.PublicBaseUrl is { Length: > 0 } configured ? configured : Nav.BaseUri).TrimEnd('/');

    // One MCP registration per KEYWARD, named after its host (amkeyward-toolbox-example-com), so several sit side by side.
    private string McpServerName => "amkeyward-" + new Uri(ServiceUri).Host.ToLowerInvariant().Replace('.', '-');

    private string SetupScript => string.Join("\n", UsageSteps.Select(s => s.Command).OfType<string>());

    // Windows puts the .NET tools folder on PATH; on macOS it is not, so the commands name the program by its path —
    // which also lets the AI agent start it whatever PATH it was launched with.
    private bool mac;

    private string Tool => mac ? "~/.dotnet/tools/amkeyward-mcp" : "amkeyward-mcp";

    private string DotNetCommand => mac ? "brew install --cask dotnet-sdk" : "winget install Microsoft.DotNet.SDK.10";

    // The single-file program on GitHub Releases, for computers without .NET (decision T10 A).
    private const string NoDotNetGuide = "https://github.com/ardimedia-com/am-keyward/blob/main/docs/agent-api.md#without-net";

    private IReadOnlyList<(string Label, string? Command)> UsageSteps =>
    [
        (Loc["AgentTokens.Usage.Install"], "dotnet tool install --global Am.Keyward.Mcp --prerelease"),
        (Loc["AgentTokens.Usage.Store"], $"{Tool} setup {ServiceUri}"),
        (Loc["AgentTokens.Usage.Check"], mac
            ? $"Keyward__ServiceUri={ServiceUri} {Tool} check"
            : $"$env:Keyward__ServiceUri = \"{ServiceUri}\"; {Tool} check"),
        (Loc["AgentTokens.Usage.Register"], $"claude mcp add {McpServerName} --scope user --env Keyward__ServiceUri={ServiceUri} -- {Tool}"),
        (Loc["AgentTokens.Usage.Ask"], null),
    ];

    // The setup in reverse; each step stands on its own (a lost computer needs only the last one).
    private IReadOnlyList<(string Label, string? Command)> UninstallSteps =>
    [
        (Loc["AgentTokens.Uninstall.Unregister", McpServerName], $"claude mcp remove {McpServerName} --scope user"),
        (Loc["AgentTokens.Uninstall.Forget"], $"{Tool} remove {ServiceUri}"),
        (Loc["AgentTokens.Uninstall.Tool"], "dotnet tool uninstall --global Am.Keyward.Mcp"),
        (Loc["AgentTokens.Uninstall.Revoke"], null),
    ];
    private Guid? confirmRevokeId;
    private Guid? confirmDeleteId;
    private Guid? extendTokenId;
    private int extendDays = (int)AgentTokenLifetime.Default.TotalDays;

    // Edit mode: the form above changes an existing token instead of issuing one; the token value stays.
    private Guid? editingTokenId;

    // Sections: the tokens are open, «How to use» and the issue form start closed («Edit» opens the form).
    private bool showTokens = true;
    private bool showAdmin;
    private bool canAdminister;
    private IReadOnlyList<AgentTokenAdminSummary>? adminTokens;
    private Guid? adminConfirmRevokeId;
    private bool showUsage;
    private bool showUninstall;
    private bool showForm;
    private ElementReference nameInput;
    private ElementReference issuedCopyButton;
    private bool allAgentVaults;
    private bool allApplications;

    private (string Text, bool IsError)? status;
    private bool busy;

    private bool ManagesApplications => selectedScopes.HasFlag(AgentScopes.ManageApplications);

    private AgentScopes VaultScopes => selectedScopes & AgentScopeGroups.Vault;

    // Vault permissions count only with a vault ticked (so an applications-only token needs no unticking), a ticked
    // vault needs a vault permission, «Manage applications» an application or the right to create one.
    private bool HasVaults => allAgentVaults || selectedVaults.Count > 0;

    private AgentScopes EffectiveScopes =>
        (HasVaults ? VaultScopes : AgentScopes.None)
        | (ManagesApplications ? AgentScopes.ManageApplications : AgentScopes.None);

    private bool CanIssue =>
        !string.IsNullOrWhiteSpace(name)
        && EffectiveScopes != AgentScopes.None
        && (!HasVaults || VaultScopes != AgentScopes.None)
        && (!ManagesApplications || allApplications || selectedApplications.Count > 0 || mayCreateApplications)
        && (editingTokenId is not null || days is >= 1 && days <= MaxDays);

    // What the form sends: an «all» option replaces its list, and nothing is sent for a permission that is not ticked.
    private List<Guid> VaultsToSend => HasVaults && VaultScopes != AgentScopes.None && !allAgentVaults ? selectedVaults.ToList() : [];

    private List<Guid> ApplicationsToSend => ManagesApplications && !allApplications ? selectedApplications.ToList() : [];

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.UserId is not { } userId)
        {
            noAccount = true;
            return;
        }

        actorUserId = userId;
        tenantId = Workspace.TenantId;
        canManageApplications = await ProjectService.CanManageAsync(tenantId, actorUserId);
        canAdminister = await AgentTokenService.CanAdministerAsync(actorUserId, tenantId);
        await ReloadAsync();

        refreshTimer = new PeriodicTimer(PendingRefresh);
        _ = RefreshPendingLoopAsync(refreshTimer);
    }

    private async Task RefreshPendingLoopAsync(PeriodicTimer timer)
    {
        try
        {
            while (await timer.WaitForNextTickAsync())
            {
                if (busy) continue;
                var fresh = await RevealRequests.ListPendingAsync(actorUserId, tenantId);
                if (!fresh.Select(r => r.Id).SequenceEqual(pending?.Select(r => r.Id) ?? []))
                {
                    pending = fresh;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (ObjectDisposedException)
        {
            // The page was left.
        }
        catch (Exception ex)
        {
            status = (Loc["Common.Error"] + ex.Message, true);
            await InvokeAsync(StateHasChanged);
        }
    }

    public ValueTask DisposeAsync()
    {
        refreshTimer?.Dispose();
        return ValueTask.CompletedTask;
    }

    private async Task ReloadAsync()
    {
        // Team vaults and the user's own personal vaults (decision T12 B), the personal ones marked as such.
        var shared = await VaultService.ListSharedVaultsAsync(actorUserId, tenantId);
        var personal = (await VaultService.ListVaultsAsync(actorUserId))
            .Select(v => v with { Name = Loc["AgentTokens.PersonalVault", v.Name] })
            .ToList();
        vaultNames = shared.Concat(personal).ToDictionary(v => v.Id, v => v.Name);
        openVaults = shared.Concat(personal).Where(v => v.AgentAccessAllowed).OrderBy(v => v.Name).ToList();
        selectedVaults.IntersectWith(openVaults.Select(v => v.Id));
        applications = (await ProjectService.ListAsync(tenantId)).OrderBy(a => a.Name).ToList();
        selectedApplications.IntersectWith(applications.Select(a => a.Id));
        tokens = await AgentTokenService.ListAsync(actorUserId, tenantId);
        if (canAdminister)
        {
            adminTokens = await AgentTokenService.ListForTenantAsync(actorUserId, tenantId);
        }
        pending = await RevealRequests.ListPendingAsync(actorUserId, tenantId);
    }

    private string FieldLabel(RevealField field) => Loc[$"AgentTokens.Field.{field}"];

    private Task ApproveAsync(Guid requestId) => RunAsync(async () =>
    {
        await RevealRequests.ApproveAsync(actorUserId, tenantId, requestId);
        await ReloadAsync();
        status = (Loc["AgentTokens.Reveal.Msg.Approved"], false);
    }, true);

    private Task RejectAsync(Guid requestId) => RunAsync(async () =>
    {
        await RevealRequests.RejectAsync(actorUserId, tenantId, requestId);
        await ReloadAsync();
        status = (Loc["AgentTokens.Reveal.Msg.Rejected"], false);
    }, true);

    private string VaultName(Guid id) => vaultNames.GetValueOrDefault(id, "?");

    private string ScopeLabel(AgentScopes scope) => Loc[$"AgentTokens.Scope.{scope}"];

    private string ApplicationsFact(AgentTokenSummary token)
    {
        if (token.AllApplications)
        {
            return Loc["AgentTokens.AllApplications"];
        }

        var names = token.ApplicationIds.Select(id => applications?.FirstOrDefault(a => a.Id == id)?.Name ?? "?").ToList();
        if (token.MayCreateApplications)
        {
            names.Add(Loc["AgentTokens.Applications.PlusNew"]);
        }

        return string.Join(", ", names);
    }

    private string StatusLabel(AgentTokenSummary token) =>
        token.RevokedAt is not null ? Loc["AgentTokens.Status.Revoked"]
        : token.IsActive ? Loc["AgentTokens.Status.Active"]
        : Loc["AgentTokens.Status.Expired"];

    private static string StatusClass(AgentTokenSummary token) => token.IsActive ? "status-active" : "status-inactive";

    private static void Toggle(HashSet<Guid> set, Guid id, ChangeEventArgs e)
    {
        if (e.Value is true) { set.Add(id); } else { set.Remove(id); }
    }

    private void ToggleScope(AgentScopes scope, ChangeEventArgs e) =>
        selectedScopes = e.Value is true ? selectedScopes | scope : selectedScopes & ~scope;

    private Task IssueAsync() => RunAsync(async () =>
    {
        // Only what the chosen permissions use: applications without «Manage applications» would be refused, so a
        // leftover tick from before unticking the permission is dropped.
        var issued = await AgentTokenService.IssueAsync(new IssueAgentTokenCommand(
            actorUserId, tenantId, name, EffectiveScopes,
            VaultsToSend,
            networks, DateTimeOffset.UtcNow.AddDays(days),
            ApplicationsToSend,
            ManagesApplications && mayCreateApplications,
            HasVaults && VaultScopes != AgentScopes.None && allAgentVaults,
            ManagesApplications && allApplications));
        ShowIssued(issued.Token);
        ResetForm();
        showForm = false;
        await ReloadAsync();
        status = (Loc["AgentTokens.Msg.Issued"], false);
        await BringIssuedIntoViewAsync();
    }, CanIssue);

    private async Task StartEditAsync(AgentTokenSummary token)
    {
        editingTokenId = token.Id;
        showForm = true;
        name = token.Name;
        networks = token.AllowedNetworks;
        selectedScopes = token.Scopes;
        allAgentVaults = token.AllAgentVaults;
        allApplications = token.AllApplications;
        mayCreateApplications = token.MayCreateApplications;
        selectedVaults.Clear();
        selectedVaults.UnionWith(token.VaultIds);
        selectedApplications.Clear();
        selectedApplications.UnionWith(token.ApplicationIds);
        status = null;
        // The form renders on the next pass; focusing its name then brings it into view.
        StateHasChanged();
        await Task.Yield();
        await nameInput.FocusAsync();
    }

    private Task SaveEditAsync() => RunAsync(async () =>
    {
        await AgentTokenService.UpdateAsync(new UpdateAgentTokenCommand(
            actorUserId, tenantId, editingTokenId!.Value, name, EffectiveScopes,
            VaultsToSend,
            networks,
            ApplicationsToSend,
            ManagesApplications && mayCreateApplications,
            HasVaults && VaultScopes != AgentScopes.None && allAgentVaults,
            ManagesApplications && allApplications));
        ResetForm();
        await ReloadAsync();
        status = (Loc["AgentTokens.Msg.Updated"], false);
    }, editingTokenId is not null && CanIssue);

    private void CancelEdit() => ResetForm();

    private void ResetForm()
    {
        editingTokenId = null;
        name = "";
        networks = "";
        selectedVaults.Clear();
        selectedApplications.Clear();
        mayCreateApplications = false;
        allAgentVaults = false;
        allApplications = false;
        selectedScopes = AgentScopes.VaultList | AgentScopes.VaultWrite;
    }

    private Task RotateAsync(Guid tokenId) => RunAsync(async () =>
    {
        var rotated = await AgentTokenService.RotateAsync(actorUserId, tenantId, tokenId);
        ShowIssued(rotated.Token);
        await ReloadAsync();
        status = (Loc["AgentTokens.Msg.Rotated"], false);
        await BringIssuedIntoViewAsync();
    }, true);

    private void StartExtend(Guid tokenId)
    {
        confirmRevokeId = null;
        extendTokenId = tokenId;
        extendDays = (int)AgentTokenLifetime.Default.TotalDays;
    }

    private Task ExtendAsync(Guid tokenId) => RunAsync(async () =>
    {
        var until = await AgentTokenService.ExtendAsync(actorUserId, tenantId, tokenId, DateTimeOffset.UtcNow.AddDays(extendDays));
        extendTokenId = null;
        await ReloadAsync();
        status = (Loc["AgentTokens.Msg.Extended", until.ToLocalTime().ToString("d")], false);
    }, extendDays is >= 1 && extendDays <= MaxDays);

    private Task AdminRevokeAsync(Guid tokenId) => RunAsync(async () =>
    {
        await AgentTokenService.RevokeAsAdminAsync(actorUserId, tenantId, tokenId);
        adminConfirmRevokeId = null;
        await ReloadAsync();
        status = (Loc["AgentTokens.Msg.Revoked"], false);
    }, true);

    private Task DeleteAsync(Guid tokenId) => RunAsync(async () =>
    {
        await AgentTokenService.DeleteAsync(actorUserId, tenantId, tokenId);
        confirmDeleteId = null;
        await ReloadAsync();
        status = (Loc["AgentTokens.Msg.Deleted"], false);
    }, true);

    private Task RevokeAsync(Guid tokenId) => RunAsync(async () =>
    {
        await AgentTokenService.RevokeAsync(actorUserId, tenantId, tokenId);
        confirmRevokeId = null;
        issuedToken = null;
        await ReloadAsync();
        status = (Loc["AgentTokens.Msg.Revoked"], false);
    }, true);

    // The new token is shown at the top of the page, far from the button that issued it: move focus (and the view) there.
    private async Task BringIssuedIntoViewAsync()
    {
        StateHasChanged();
        await Task.Yield();
        await issuedCopyButton.FocusAsync();
    }

    private void ShowIssued(string token)
    {
        issuedToken = token;
        issuedCopied = false;
    }

    private async Task CopyCommandAsync(string command)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", command);
        copiedCommand = command;
    }

    private async Task CopyIssuedAsync()
    {
        if (issuedToken is null) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", issuedToken);
        issuedCopied = true;
    }

    // Double-submit guard: the flag is set before the first await, so a second click returns at once.
    private async Task RunAsync(Func<Task> action, bool precondition)
    {
        if (busy || !precondition) return;
        busy = true;
        status = null;
        try { await action(); }
        catch (Exception ex) { status = (Loc["Common.Error"] + ex.Message, true); }
        finally { busy = false; }
    }
}
