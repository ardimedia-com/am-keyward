@page "/amkeyward/vaults/personal"
@attribute [Authorize]
@inject NavigationManager Nav

@* Former page of the personal vaults (before T13 A): forwards to the vaults page, keeping an ?item= deep link. *@
@code {
    protected override void OnInitialized() =>
        Nav.NavigateTo(KeywardRoutes.Vaults + new Uri(Nav.Uri).Query, replace: true);
}
