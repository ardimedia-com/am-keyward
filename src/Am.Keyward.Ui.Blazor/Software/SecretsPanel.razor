@namespace Am.Keyward.Ui.Blazor.Software

@inject ISoftwareSecretService SecretService
@inject IStringLocalizer<SharedResource> Loc
@inject IJSRuntime JS
@inject ILogger<SecretsPanel> Logger
@implements IDisposable

@* Application data («Applikations-Daten») for ONE application, rendered inside the Applications page's
   «Daten» tab. Two-pane master-detail (like the vault «Einträge» tab): the secret keys on the left, the
   selected key's per-environment values on the right, with «+ Schlüssel hinzufügen» at the pane's top right.
   A secret key holds ONE value per environment (server-side encrypted, versioned). Reloads when ProjectId
   changes (OnParametersSetAsync). *@
@if (secrets is null)
{
    @if (status is { IsError: true } loadError)
    {
        <div class="notice notice-error" role="alert">@loadError.Text</div>
    }
    else
    {
        <p class="muted">@Loc["Common.Loading"]</p>
    }
}
else
{
    <div class="kw-detail-split">
        <div class="kw-split-list">
            <div class="card list-card">
                <div class="list-head">
                    <h3 class="keys-title">@Loc["App.Data.KeysTitle"]</h3>
                    @if (secrets.Count > 8)
                    {
                        <input @bind="filter" @bind:event="oninput" placeholder="@(Loc["Secret.Filter"])" aria-label="@(Loc["Secret.Filter"])" class="key-filter" />
                    }
                </div>
                @if (secrets.Count == 0)
                {
                    <div class="empty-state">
                        <KeywardIcon Name="key" Size="28" />
                        <p>@Loc["Secret.Empty"]</p>
                    </div>
                }
                else
                {
                    <div class="list-rows">
                        @foreach (var s in Filtered)
                        {
                            <button class="list-row @(s.Key == selectedKey && mode == "view" ? "selected" : "")" @onclick="() => SelectAsync(s.Key)" disabled="@busy">
                                <KeywardIcon Name="key" Size="17" />
                                <span class="list-row-name">@s.Key</span>
                                <span class="list-row-meta">
                                    <span class="badge">@Loc["Secret.EnvCount", s.EnvironmentsWithValue.Count]</span>
                                    <KeywardIcon Name="chevron-right" Size="15" />
                                </span>
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="kw-split-detail">
            @if (mode == "add")
            {
                <div class="card">
                    <h3 class="add-title">@Loc["Secret.Add"]</h3>
                    <p class="muted">@Loc["Secret.Desc"]</p>
                    <div class="detail-grid add-form">
                        <div class="field"><label for="kw-secret-key">@Loc["Secret.Key"]</label><input id="kw-secret-key" @bind="addKey" placeholder="ConnectionStrings:Main" /></div>
                        <div class="field">
                            <label for="kw-secret-env">@Loc["Common.Environment"]</label>
                            <select id="kw-secret-env" @bind="addEnv">
                                @foreach (var e in environmentNames)
                                {
                                    <option value="@e">@e</option>
                                }
                            </select>
                        </div>
                        <div class="field wide"><label for="kw-secret-value">@Loc["Secret.Value"]</label><input id="kw-secret-value" @bind="addValue" autocomplete="off" /></div>
                        <div class="row wide">
                            <button @onclick="SaveNewAsync" disabled="@(busy || string.IsNullOrWhiteSpace(addKey))">@Loc["Common.Save"]</button>
                            <button class="btn-ghost" @onclick="CancelAdd">@Loc["Common.Cancel"]</button>
                        </div>
                    </div>
                    @if (addStatus is not null)
                    {
                        <div class="notice @(addStatus.Value.IsError ? "notice-error" : "")" role="@(addStatus.Value.IsError ? "alert" : "status")">@addStatus.Value.Text</div>
                    }
                </div>
            }
            else if (detail is not null)
            {
                <div class="card">
                    <div class="row detail-head">
                        @if (renaming)
                        {
                            <div class="row rename-row">
                                <KeywardIcon Name="key" Size="18" />
                                <input @bind="renameValue" aria-label="@(Loc["Secret.Rename"])" autocomplete="off" class="rename-input" />
                                <button class="btn-sm" @onclick="RenameAsync" disabled="@(busy || string.IsNullOrWhiteSpace(renameValue))">@Loc["Common.Save"]</button>
                                <button class="btn-ghost btn-sm" @onclick="CancelRename">@Loc["Common.Cancel"]</button>
                            </div>
                        }
                        else
                        {
                            <h3 class="detail-title"><KeywardIcon Name="key" Size="18" /><code>@detail.Key</code></h3>
                            <div class="row">
                                <button class="btn-sm" @onclick="StartAdd" disabled="@busy"><KeywardIcon Name="plus" />@Loc["Secret.Add"]</button>
                                <button class="btn-ghost btn-sm" @onclick="StartRename" disabled="@busy"><KeywardIcon Name="pencil" Size="14" /> @Loc["Common.Rename"]</button>
                                <button class="btn-ghost btn-sm" @onclick="ToggleRevealAll"><KeywardIcon Name="@(reveal ? "eye-off" : "eye")" Size="14" /> @(reveal ? Loc["Secret.HideValues"] : Loc["Secret.RevealValues"])</button>
                                <button class="btn-danger btn-sm" @onclick="() => confirmDelete = true" disabled="@busy">@Loc["Common.DeleteEllipsis"]</button>
                            </div>
                        }
                    </div>
                    @if (renaming)
                    {
                        <div class="notice detail-notice" role="status">@Loc["Secret.Rename.Hint"]</div>
                    }
                    @if (confirmDelete)
                    {
                        <div class="notice notice-error detail-notice">
                            @Loc["Secret.ConfirmDelete", detail.Key]
                            <button class="btn-danger btn-sm confirm-yes" @onclick="DeleteCurrentAsync" disabled="@busy">@Loc["Common.Yes"]</button>
                            <button class="btn-ghost btn-sm" @onclick="() => confirmDelete = false">@Loc["Common.Cancel"]</button>
                        </div>
                    }
                    <p class="muted">@Loc["Secret.View.Desc"]</p>
                    @* min-width: below it the fixed-layout columns would collapse into each other (values,
                       "set new value" input and the last-read column overlapping) — with it, the surrounding
                       .table-scroll takes over and scrolls horizontally instead. *@
                    <div class="table-scroll">
                        <table class="values-table">
                            <thead>
                                <tr>
                                    <th class="col-env">@Loc["Common.Environment"]</th>
                                    <th class="col-value">@Loc["Secret.CurrentValue"]</th>
                                    <th class="col-value">@Loc["Secret.SetNewValue"]</th>
                                    <th class="col-rotation">@Loc["Secret.Rotation.Column"]</th>
                                    <th class="col-read">@Loc["Secret.LastRead"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var env in detail.Environments)
                                {
                                    var shown = reveal || revealedEnvironments.Contains(env.Environment);
                                    <tr>
                                        <td>
                                            <div>@env.Environment</div>
                                            @* The note lives IN the environment cell: it is what a reader of the row needs
                                               («where does this value come from, who owns it»), and the editor column may be
                                               scrolled out of view on a narrow panel. Click opens the editor below the row. *@
                                            @if (!string.IsNullOrWhiteSpace(env.Note))
                                            {
                                                <button type="button" class="kw-env-note" title="@Loc["Secret.Note.Edit"]" @onclick="() => OpenRotation(env)">@env.Note</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="kw-env-note kw-env-note-empty" @onclick="() => OpenRotation(env)">@Loc["Secret.Note.Add"]</button>
                                            }
                                        </td>
                                        <td>
                                            <div class="row value-row">
                                                <code class="value-text">@(env.HasValue ? (shown ? env.Value : "••••••••") : "—")</code>
                                                @if (env.HasValue)
                                                {
                                                    <button class="icon-btn" title="@(shown ? Loc["Common.Hide"] : Loc["Common.Reveal"])" aria-label="@(shown ? Loc["Common.Hide"] : Loc["Common.Reveal"])" @onclick="() => ToggleRowReveal(env.Environment)"><KeywardIcon Name="@(shown ? "eye-off" : "eye")" Size="15" /></button>
                                                    <button class="icon-btn" title="@Loc["Common.Copy"]" aria-label="@Loc["Common.Copy"]" @onclick="() => CopyAsync(env.Environment, env.Value ?? string.Empty)"><KeywardIcon Name="@(copiedEnv == env.Environment ? "check" : "copy")" Size="15" /></button>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <div class="row value-row">
                                                <input @bind="editValues[env.Environment]" placeholder="@(Loc["Secret.NewValuePlaceholder"])" aria-label="@(Loc["Secret.SetNewValue"])" autocomplete="off" class="new-value-input" />
                                                <button class="btn-sm" @onclick="() => SetValueAsync(env.Environment)" disabled="@(busy || string.IsNullOrEmpty(editValues[env.Environment]))">@Loc["Common.Save"]</button>
                                            </div>
                                        </td>
                                        <td class="cell-small">
                                            @* Rotation: the state as a chip, the editor one click away (below
                                               the row) so the table keeps its four working columns readable. *@
                                            <button class="btn-ghost btn-sm rotation-toggle"
                                                    title="@Loc["Secret.Rotation.Edit"]" @onclick="() => ToggleRotation(env)">
                                                <span class="@RotationChipClass(env.ExpiresAt)">@RotationLabel(env)</span>
                                                <KeywardIcon Name="@(rotationOpen.Contains(env.Environment) ? "chevron-down" : "chevron-right")" Size="14" />
                                            </button>
                                        </td>
                                        <td class="muted cell-small">
                                            @if (env.LastReadAt is { } lastRead)
                                            {
                                                <span title="@Loc["Secret.ReadCount", env.ReadCount]">
                                                    <LocalTime Utc="lastRead" /><br />@ReadSourceLabel(env.LastReadVia)
                                                </span>
                                            }
                                            else
                                            {
                                                <span>@Loc["Secret.NeverRead"]</span>
                                            }
                                        </td>
                                    </tr>
                                    @if (rotationOpen.Contains(env.Environment))
                                    {
                                        <tr class="kw-rotation-row">
                                            <td colspan="5">
                                                <div class="kw-rotation-editor">
                                                    <div class="field">
                                                        <label for="kw-rot-date-@env.Environment">@Loc["Secret.Rotation.ExpiresAt"]</label>
                                                        <input id="kw-rot-date-@env.Environment" type="date" @bind="rotationExpiry[env.Environment]" />
                                                    </div>
                                                    <div class="field wide">
                                                        <label for="kw-rot-note-@env.Environment">@Loc["Secret.Rotation.Note"]</label>
                                                        <textarea id="kw-rot-note-@env.Environment" rows="3" maxlength="1024"
                                                                  placeholder="@(Loc["Secret.Rotation.NotePlaceholder"])" @bind="rotationNote[env.Environment]"></textarea>
                                                    </div>
                                                    <div class="row wide">
                                                        <button class="btn-sm" @onclick="() => SaveRotationAsync(env.Environment)" disabled="@busy">@Loc["Common.Save"]</button>
                                                        <button class="btn-ghost btn-sm" @onclick="() => rotationOpen.Remove(env.Environment)">@Loc["Common.Cancel"]</button>
                                                        <span class="muted rotation-advisory">@Loc["Secret.Rotation.Advisory"]</span>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="card">
                    <div class="row empty-actions">
                        <button class="btn-sm" @onclick="StartAdd" disabled="@busy"><KeywardIcon Name="plus" />@Loc["Secret.Add"]</button>
                    </div>
                    <div class="empty-state">
                        <KeywardIcon Name="key" Size="28" />
                        <p>@(secrets.Count == 0 ? Loc["Secret.Empty"] : Loc["Secret.SelectHint"])</p>
                    </div>
                </div>
            }

            @if (status is not null)
            {
                <div class="notice @(status.Value.IsError ? "notice-error" : "")" role="@(status.Value.IsError ? "alert" : "status")">@status.Value.Text</div>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid TenantId { get; set; }
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter] public Guid? ActorUserId { get; set; }

    /// <summary>A key to open (e.g. from the applications search); applied whenever <see cref="FocusRequest"/> changes.</summary>
    [Parameter] public string? FocusKey { get; set; }

    [Parameter] public int FocusRequest { get; set; }

    private int appliedFocus;

    private Guid loadedProjectId;

    private IReadOnlyList<SoftwareSecretSummary>? secrets;
    private string? selectedKey;
    private SoftwareSecretDetail? detail;
    private string mode = "view"; // "view" | "add"
    private bool reveal;
    private readonly HashSet<string> revealedEnvironments = [];

    // Revealed values are masked again after a short while (SecretExposure.RevealVisible), so a value does not stay
    // on screen when the user walks away.
    private readonly DelayedAction autoHide = new();
    private string? copiedEnv;
    private bool confirmDelete;
    private bool renaming;
    private string renameValue = "";
    private string filter = "";

    private IReadOnlyList<string> environmentNames = [];
    private string addKey = "";
    private string addEnv = "Development";
    private string addValue = "";

    private readonly Dictionary<string, string> editValues = new();

    // Rotation editor (expiry date + note), open per environment name. The date is a DateOnly? because the
    // native <input type="date"> binds to one directly — and because the expiry IS a date, not an instant.
    private readonly HashSet<string> rotationOpen = [];
    private readonly Dictionary<string, DateOnly?> rotationExpiry = new();
    private readonly Dictionary<string, string> rotationNote = new();

    private (string Text, bool IsError)? status;
    private (string Text, bool IsError)? addStatus;
    private bool busy;

    // The expiry is a DATE, deliberately handled in UTC end-of-day (see SetValueRotationAsync): converting a
    // day-granular value into the viewer's zone would shift the displayed DAY, which is worse than showing
    // the date exactly as it was entered. Timestamps with a time-of-day (last read) still render local.
    private static string FormatExpiryDate(DateTimeOffset value) => value.UtcDateTime.ToString("yyyy-MM-dd");

    private string RotationLabel(SecretEnvironmentValue env)
    {
        if (env.ExpiresAt is not { } expires)
        {
            return string.IsNullOrWhiteSpace(env.Note) ? Loc["Secret.Rotation.None"] : Loc["Secret.Rotation.NoteOnly"];
        }

        var daysLeft = ExpiryNoticePolicy.DaysLeft(DateTimeOffset.UtcNow, expires);
        return daysLeft < 1
            ? Loc["Secret.Rotation.Overdue", FormatExpiryDate(expires)]
            : Loc["Secret.Rotation.DaysLeft", daysLeft, FormatExpiryDate(expires)];
    }

    /// <summary>Chip colour: overdue is loud, inside the notice window is a warning, further out is quiet.</summary>
    private static string RotationChipClass(DateTimeOffset? expiresAt)
    {
        if (expiresAt is not { } expires)
        {
            return "muted";
        }

        var daysLeft = ExpiryNoticePolicy.DaysLeft(DateTimeOffset.UtcNow, expires);
        return daysLeft < 1 ? "kw-rot-overdue" : daysLeft <= ExpiryNoticePolicy.WindowDays ? "kw-rot-due" : "kw-rot-ok";
    }

    /// <summary>Opens the editor for this environment (a no-op when it is open) — the note's click target.</summary>
    private void OpenRotation(SecretEnvironmentValue env)
    {
        if (!rotationOpen.Contains(env.Environment))
        {
            ToggleRotation(env);
        }
    }

    private void ToggleRotation(SecretEnvironmentValue env)
    {
        if (!rotationOpen.Add(env.Environment))
        {
            rotationOpen.Remove(env.Environment);
            return;
        }

        // Seed the editor from the stored state each time it opens, so a cancelled edit leaves nothing behind.
        rotationExpiry[env.Environment] = env.ExpiresAt is { } expires ? DateOnly.FromDateTime(expires.UtcDateTime) : null;
        rotationNote[env.Environment] = env.Note;
    }

    private Task SaveRotationAsync(string environment) => RunAsync(async () =>
    {
        // "Valid through the end of that day" (see SecretValue.EndOfDay).
        var expiresAt = rotationExpiry.GetValueOrDefault(environment) is { } date
            ? Am.Keyward.Core.Domain.Software.SecretValue.EndOfDay(date)
            : (DateTimeOffset?)null;

        var key = detail!.Key;
        await SecretService.SetValueRotationAsync(
            TenantId, ProjectId, key, environment, expiresAt, rotationNote.GetValueOrDefault(environment, ""), ActorUserId);
        rotationOpen.Remove(environment);
        await LoadDetailAsync(key);
        status = (Loc["Secret.Rotation.Msg.Saved", key, environment], false);
    }, detail is not null);

    private string ReadSourceLabel(string? source) => source switch
    {
        "InProcess" => Loc["Secret.ReadSource.InProcess"],
        "Client" => Loc["Secret.ReadSource.Client"],
        _ => source ?? "",
    };

    private IEnumerable<SoftwareSecretSummary> Filtered =>
        secrets is null ? []
        : string.IsNullOrWhiteSpace(filter) ? secrets
        : secrets.Where(s => s.Key.Contains(filter.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnParametersSetAsync()
    {
        // Parameter-driven loads (another application picked, a search hit opened) cannot wait for a busy flag, but
        // they get the same error handling as every action.
        try
        {
            if (ProjectId != loadedProjectId)
            {
                loadedProjectId = ProjectId;
                status = null;
                await LoadAsync(ProjectId);
            }

            if (FocusRequest != appliedFocus)
            {
                appliedFocus = FocusRequest;
                if (FocusKey is { } key && secrets?.Any(s => string.Equals(s.Key, key, StringComparison.OrdinalIgnoreCase)) == true)
                {
                    await LoadDetailAsync(secrets.First(s => string.Equals(s.Key, key, StringComparison.OrdinalIgnoreCase)).Key);
                }
            }
        }
        catch (Exception ex)
        {
            status = (UserFacingError.Describe(ex, Loc, Logger), true);
        }
    }

    private async Task LoadAsync(Guid projectId)
    {
        selectedKey = null;
        detail = null;
        mode = "view";
        filter = "";
        confirmDelete = false;
        renaming = false;
        HideValues();
        var names = (await SecretService.ListEnvironmentsAsync(TenantId, projectId)).Select(e => e.Name).ToList();
        var list = await SecretService.ListSecretsAsync(TenantId, projectId);
        if (projectId != loadedProjectId)
        {
            return; // another application was picked meanwhile; its own load wins
        }

        environmentNames = names;
        if (!environmentNames.Contains(addEnv))
        {
            addEnv = environmentNames.FirstOrDefault() ?? addEnv;
        }
        secrets = list;
        if (secrets is { Count: 1 })
        {
            await LoadDetailAsync(secrets[0].Key);
        }
    }

    private async Task ReloadAsync() =>
        secrets = await SecretService.ListSecretsAsync(TenantId, ProjectId);

    private Task SelectAsync(string key) => RunAsync(() => LoadDetailAsync(key), true);

    private async Task LoadDetailAsync(string key)
    {
        selectedKey = key;
        mode = "view";
        detail = await SecretService.GetSecretAsync(TenantId, ProjectId, key);
        HideValues();
        copiedEnv = null;
        confirmDelete = false;
        renaming = false;
        editValues.Clear();
        rotationOpen.Clear();
        rotationExpiry.Clear();
        rotationNote.Clear();
        if (detail is not null)
        {
            foreach (var e in detail.Environments)
            {
                editValues[e.Environment] = "";
            }
        }
    }

    private void StartAdd()
    {
        mode = "add";
        detail = null;
        selectedKey = null;
        addKey = "";
        addValue = "";
        addStatus = null;
        renaming = false;
    }

    private void StartRename()
    {
        renaming = true;
        renameValue = detail?.Key ?? "";
        confirmDelete = false;
        status = null;
    }

    private void CancelRename() => renaming = false;

    private void CancelAdd()
    {
        mode = "view";
        addStatus = null;
    }

    private void ToggleRevealAll()
    {
        reveal = !reveal;
        ScheduleAutoHide();
    }

    private void ToggleRowReveal(string environment)
    {
        if (!revealedEnvironments.Add(environment))
        {
            revealedEnvironments.Remove(environment);
        }

        ScheduleAutoHide();
    }

    // Every new reveal restarts the countdown; once nothing is revealed any more there is nothing to count down.
    private void ScheduleAutoHide()
    {
        if (!reveal && revealedEnvironments.Count == 0)
        {
            autoHide.Cancel();
            return;
        }

        autoHide.Schedule(SecretExposure.RevealVisible, () => InvokeAsync(() =>
        {
            HideValues();
            StateHasChanged();
        }));
    }

    private void HideValues()
    {
        reveal = false;
        revealedEnvironments.Clear();
        autoHide.Cancel();
    }

    public void Dispose() => autoHide.Dispose();

    private async Task CopyAsync(string environment, string value)
    {
        if (!await JS.TryCopySecretToClipboardAsync(value)) return;
        copiedEnv = environment;
        StateHasChanged();
        await Task.Delay(1200);
        copiedEnv = null;
    }

    private Task SetValueAsync(string environment) => RunAsync(async () =>
    {
        var key = detail!.Key;
        await SecretService.StoreAsync(new StoreSoftwareSecretCommand(TenantId, ProjectId, environment, key, editValues[environment], ActorUserId));
        await LoadDetailAsync(key);
        await ReloadAsync();
        status = (Loc["Secret.Msg.Saved", key, environment], false);
    }, detail is not null && !string.IsNullOrEmpty(editValues.GetValueOrDefault(environment)));

    private Task SaveNewAsync() => RunAsync(async () =>
    {
        var key = addKey.Trim();
        if (secrets?.Any(s => s.Key.Equals(key, StringComparison.OrdinalIgnoreCase)) == true)
        {
            addStatus = (Loc["Secret.Msg.DuplicateKey", key], true);
            return;
        }

        await SecretService.StoreAsync(new StoreSoftwareSecretCommand(TenantId, ProjectId, addEnv, key, addValue, ActorUserId));
        await ReloadAsync();
        await LoadDetailAsync(key);
        status = (Loc["Secret.Msg.Created", key], false);
    }, !string.IsNullOrWhiteSpace(addKey));

    private Task RenameAsync() => RunAsync(async () =>
    {
        var oldKey = detail!.Key;
        var newKey = renameValue.Trim();
        if (string.Equals(oldKey, newKey, StringComparison.Ordinal))
        {
            renaming = false;
            return;
        }

        if (secrets?.Any(s => !s.Key.Equals(oldKey, StringComparison.OrdinalIgnoreCase)
                              && s.Key.Equals(newKey, StringComparison.OrdinalIgnoreCase)) == true)
        {
            status = (Loc["Secret.Msg.DuplicateKey", newKey], true);
            return;
        }

        await SecretService.RenameSecretAsync(TenantId, ProjectId, oldKey, newKey, ActorUserId);
        renaming = false;
        await ReloadAsync();
        await LoadDetailAsync(newKey);
        status = (Loc["Secret.Msg.Renamed", oldKey, newKey], false);
    }, detail is not null && !string.IsNullOrWhiteSpace(renameValue));

    private Task DeleteCurrentAsync() => RunAsync(async () =>
    {
        await SecretService.DeleteSecretAsync(TenantId, ProjectId, detail!.Key, ActorUserId);
        selectedKey = null;
        detail = null;
        confirmDelete = false;
        await ReloadAsync();
        status = (Loc["Secret.Msg.Deleted"], false);
    }, detail is not null);

    private async Task RunAsync(Func<Task> action, bool precondition)
    {
        if (busy || !precondition) return;
        busy = true;
        status = null;
        addStatus = null;
        try { await action(); }
        catch (Exception ex) { status = (UserFacingError.Describe(ex, Loc, Logger), true); }
        finally { busy = false; }
    }
}
