@namespace Am.Keyward.Ui.Blazor.Software
@using Am.Keyward.Core.Domain.Software
@inject ISoftwareClientTokenService TokenService
@inject ISoftwareSecretService SecretService
@inject ITokenAccessStatisticsService StatsService
@inject IStringLocalizer<SharedResource> Loc
@inject BrowserTimeService Time
@implements IDisposable

@* Access statistics for ONE application, rendered inside the Applications page's «Statistics» tab. Three
   collapsible areas: per-token daily request bars (trailing @ChartDays days), the IPs each token has been seen
   from, and the recent access-pattern alerts (new IP / resumed after silence). All data is pre-aggregated
   by the background flush — nothing here is per-request. Reloads when ProjectId changes. *@
@if (tokens is null || daily is null || ips is null || alerts is null)
{
    <p class="muted">@Loc["Common.Loading"]</p>
}
else if (tokens.Count == 0)
{
    <div class="card">
        <div class="empty-state">
            <KeywardIcon Name="chart-column" Size="28" />
            <p>@Loc["Stats.Empty"]</p>
        </div>
    </div>
}
else
{
    <KeywardArea Title="@Loc["Stats.Requests.Title", ChartDays]" Icon="chart-column" RememberKey="keyward.applications.stats-requests">
        <p class="muted">@Loc["Stats.Requests.Desc"]</p>
        <div class="list-rows">
            @foreach (var token in tokens.OrderBy(t => EnvironmentOrderOf(t.EnvironmentId)).ThenBy(t => t.Name))
            {
                var byDay = DailyFor(token.Id);
                var total = byDay.Values.Sum();
                <div class="list-row list-row-static token-row">
                    <KeywardIcon Name="ticket" Size="17" />
                    <span class="list-row-name">@token.Name</span>
                    <span class="badge">@EnvironmentNameOf(token.EnvironmentId)</span>
                    <span class="list-row-meta">
                        <span class="muted row-fact">
                            @(token.LastAccessAt is { } lastAccess
                                ? Loc["Token.LastAccess.Value", Time.Format(lastAccess, "yyyy-MM-dd HH:mm:ss")]
                                : Loc["Token.LastAccess.Never"])
                            @if (token.LastAccessIp is { Length: > 0 } lastIp) { <text> · </text> <code>@lastIp</code> }
                        </span>
                        <span class="kw-bars" role="img" aria-label="@Loc["Stats.Requests.Total", total]">
                            @foreach (var day in ChartWindow())
                            {
                                var count = byDay.GetValueOrDefault(day);
                                <span class="kw-bar @(count == 0 ? "kw-bar-empty" : "")"
                                      style="height:@(BarHeightPercent(count, byDay))%"
                                      title="@day.ToString("yyyy-MM-dd"): @count"></span>
                            }
                        </span>
                        <span class="muted row-fact row-total">@Loc["Stats.Requests.Total", total]</span>
                    </span>
                </div>
            }
        </div>
    </KeywardArea>

    <KeywardArea Title="@Loc["Stats.Ips.Title"]" Icon="globe" RememberKey="keyward.applications.stats-ips">
        <p class="muted">@Loc["Stats.Ips.Desc"]</p>
        @if (ips.Count == 0)
        {
            <p class="muted">@Loc["Stats.Ips.Empty"]</p>
        }
        else
        {
            <div class="list-rows">
                @foreach (var ip in ips)
                {
                    <div class="list-row list-row-static">
                        <KeywardIcon Name="globe" Size="17" />
                        <code class="list-row-name ip-address">@ip.IpAddress</code>
                        <span class="badge">@TokenNameOf(ip.TokenId)</span>
                        <span class="list-row-meta">
                            <span class="muted row-fact">
                                @Loc["Stats.Ips.Seen", Time.Format(ip.FirstSeenAt, "yyyy-MM-dd HH:mm:ss"), Time.Format(ip.LastSeenAt, "yyyy-MM-dd HH:mm:ss")]
                            </span>
                        </span>
                    </div>
                }
            </div>
        }
    </KeywardArea>

    @* The alerts that are not a recovery are named on the collapsed area too. *@
    <KeywardArea Title="@Loc["Stats.Alerts.Title"]" Icon="bell" RememberKey="keyward.applications.stats-alerts"
                 Notice="@(OpenAlertCount > 0 ? Loc["Stats.Alerts.Notice", OpenAlertCount].Value : null)">
        <p class="muted">@Loc["Stats.Alerts.Desc"]</p>
        @if (alerts.Count == 0)
        {
            <p class="muted">@Loc["Stats.Alerts.Empty"]</p>
        }
        else
        {
            <div class="list-rows">
                @foreach (var alert in alerts)
                {
                    <div class="list-row list-row-static">
                        <KeywardIcon Name="bell" Size="17" />
                        <span class="badge @(alert.Kind == TokenAccessAlertKind.HeartbeatRecovered ? "badge-success" : "badge-warning")">@KindLabel(alert.Kind)</span>
                        <span class="list-row-name alert-text">@AlertText(alert)</span>
                        <span class="list-row-meta">
                            <span class="muted row-fact"><LocalTime Utc="alert.CreatedAt" /></span>
                        </span>
                    </div>
                }
            </div>
        }
    </KeywardArea>
}

@code {
    private const int ChartDays = 14;
    private const int LoadDays = 30;

    [Parameter, EditorRequired] public Guid TenantId { get; set; }
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }

    private Guid loadedProjectId;

    private IReadOnlyList<EnvironmentInfo>? environments;
    private IReadOnlyList<SoftwareClientTokenInfo>? tokens;
    private IReadOnlyList<TokenDailyAccessInfo>? daily;
    private IReadOnlyList<TokenAccessIpInfo>? ips;
    private IReadOnlyList<TokenAccessAlertInfo>? alerts;
    private DateOnly statisticsToday;

    // Timestamps inside localized strings can't use <LocalTime/> — refresh once the browser zone resolves.
    protected override void OnInitialized() => Time.Changed += OnTimeZoneResolved;

    private void OnTimeZoneResolved() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Time.Changed -= OnTimeZoneResolved;

    protected override async Task OnParametersSetAsync()
    {
        if (ProjectId != loadedProjectId)
        {
            loadedProjectId = ProjectId;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        environments = await SecretService.ListEnvironmentsAsync(TenantId, ProjectId);
        tokens = await TokenService.ListAsync(TenantId, ProjectId);
        statisticsToday = StatsService.CurrentStatisticsDay;
        daily = await StatsService.ListDailyAsync(TenantId, ProjectId, LoadDays);
        ips = await StatsService.ListIpsAsync(TenantId, ProjectId);
        alerts = await StatsService.ListAlertsAsync(TenantId, ProjectId);
    }

    private string EnvironmentNameOf(Guid environmentId) =>
        environments?.FirstOrDefault(e => e.Id == environmentId)?.Name ?? "?";

    // Position in the service-provided list, which is ordered by the environments' display order
    // (Development, Test, Production — never alphabetical).
    private int EnvironmentOrderOf(Guid environmentId)
    {
        var index = environments is null ? -1 : environments.ToList().FindIndex(e => e.Id == environmentId);
        return index < 0 ? int.MaxValue : index;
    }

    private string TokenNameOf(Guid tokenId) =>
        tokens?.FirstOrDefault(t => t.Id == tokenId)?.Name ?? "?";

    private Dictionary<DateOnly, long> DailyFor(Guid tokenId) =>
        daily!.Where(d => d.TokenId == tokenId).ToDictionary(d => d.Date, d => d.RequestCount);

    // Fixed day slots (oldest → today, in the installation's statistics zone — the zone the buckets are
    // keyed by) so every token's bars align on the same axis.
    private IEnumerable<DateOnly> ChartWindow()
    {
        var today = statisticsToday;
        for (var i = ChartDays - 1; i >= 0; i--)
        {
            yield return today.AddDays(-i);
        }
    }

    // Height relative to the token's own busiest day; a non-zero count always gets a visible sliver.
    private static int BarHeightPercent(long count, Dictionary<DateOnly, long> byDay)
    {
        if (count == 0)
        {
            return 4;
        }

        var max = byDay.Values.Max();
        return Math.Max((int)(count * 100 / max), 12);
    }

    // Alerts that ask for a look: everything except a heartbeat that came back.
    private int OpenAlertCount => alerts?.Count(a => a.Kind != TokenAccessAlertKind.HeartbeatRecovered) ?? 0;

    private string KindLabel(TokenAccessAlertKind kind) => kind switch
    {
        TokenAccessAlertKind.NewIpAddress => Loc["Stats.Alert.NewIp"].Value,
        TokenAccessAlertKind.ResumedAfterSilence => Loc["Stats.Alert.Resumed"].Value,
        TokenAccessAlertKind.HeartbeatMissed => Loc["Stats.Alert.HeartbeatMissed"].Value,
        _ => Loc["Stats.Alert.HeartbeatRecovered"].Value,
    };

    private string AlertText(TokenAccessAlertInfo alert) => alert.Kind switch
    {
        TokenAccessAlertKind.NewIpAddress => Loc["Stats.Alert.NewIp.Text", TokenNameOf(alert.TokenId), alert.IpAddress ?? "?"].Value,
        TokenAccessAlertKind.ResumedAfterSilence => Loc["Stats.Alert.Resumed.Text", TokenNameOf(alert.TokenId), alert.IpAddress ?? "?"].Value,
        TokenAccessAlertKind.HeartbeatMissed => Loc["Stats.Alert.HeartbeatMissed.Text", TokenNameOf(alert.TokenId)].Value,
        _ => Loc["Stats.Alert.HeartbeatRecovered.Text", TokenNameOf(alert.TokenId)].Value,
    };
}
