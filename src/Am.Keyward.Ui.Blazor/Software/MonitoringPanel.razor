@namespace Am.Keyward.Ui.Blazor.Software
@using System.Globalization
@using Am.Keyward.Core.Domain.Software
@inject ISoftwareClientTokenService TokenService
@inject ISoftwareSecretService SecretService
@inject ITokenAccessMonitorService MonitorService
@inject IStringLocalizer<SharedResource> Loc
@inject BrowserTimeService Time
@inject ILogger<MonitoringPanel> Logger
@implements IDisposable

@* Heartbeat monitoring for ONE application, rendered inside the Applications page's «Monitoring» tab.
   Per client token a silence monitor (dead-man's switch): the token's secret reads are its heartbeat, and
   when the in-window silence exceeds the allowed maximum, an alert row is written and the opt-in mail goes
   out. The edit card opens ABOVE the list (UI convention); rows are grouped by the environments' display
   order. Times are shown in the viewer's local time zone (stored UTC), matching the statistics tab. *@
@if (tokens is null || monitors is null || environments is null)
{
    @if (status is { IsError: true } loadError)
    {
        <div class="notice notice-error" role="alert">@loadError.Text</div>
    }
    else
    {
        <p class="muted">@Loc["Common.Loading"]</p>
    }
}
else if (tokens.Count == 0)
{
    <div class="card">
        <div class="empty-state">
            <KeywardIcon Name="activity" Size="28" />
            <p>@Loc["Monitor.Empty"]</p>
        </div>
    </div>
}
else
{
    <div class="notice usage-note">@Loc["Monitor.UsageNote"]</div>

    @if (SelectedToken is { } selected)
    {
        <div class="card editor-card">
            <h3 class="editor-title">
                <KeywardIcon Name="activity" Size="18" />@Loc["Monitor.Edit.Title", selected.Name]
            </h3>
            <p class="muted editor-desc">@Loc["Monitor.Edit.Desc"]</p>

            <div class="field">
                <label for="kw-monitor-silence">@Loc["Monitor.MaxSilence.Label"]</label>
                <div class="inline-controls">
                    <input id="kw-monitor-silence" type="number" min="@(silenceUnit == "m" ? MinimumSilenceMinutes : 1)" class="silence-value"
                           @bind="silenceValue" aria-describedby="kw-monitor-silence-min" />
                    <select class="auto-width" @bind="silenceUnit" aria-label="@Loc["Monitor.MaxSilence.Label"]">
                        <option value="m">@Loc["Monitor.Unit.Minutes"]</option>
                        <option value="h">@Loc["Monitor.Unit.Hours"]</option>
                        <option value="d">@Loc["Monitor.Unit.Days"]</option>
                    </select>
                </div>
                @* The installation cannot resolve a shorter silence (check + statistics flush interval); say so here
                   instead of letting the save fail. *@
                <p id="kw-monitor-silence-min" class="muted field-hint">@Loc["Monitor.MaxSilence.Minimum", MinimumSilenceMinutes]</p>
            </div>

            <div class="field" role="group" aria-labelledby="kw-monitor-days">
                <span id="kw-monitor-days" class="group-label">@Loc["Monitor.Window.Days"]</span>
                <div class="day-choices">
                    @for (var i = 0; i < 7; i++)
                    {
                        var index = i;
                        <label class="day-choice">
                            <input type="checkbox" checked="@dayFlags[index]"
                                   @onchange="e => dayFlags[index] = e.Value is true" />
                            <span>@DayLabel(index)</span>
                        </label>
                    }
                </div>
            </div>

            <div class="field">
                <label for="kw-monitor-start">@Loc["Monitor.Window.Hours"]</label>
                <div class="inline-controls inline-wrap">
                    <input id="kw-monitor-start" type="time" class="auto-width" @bind="windowStart" />
                    <span class="muted">–</span>
                    <input type="time" class="auto-width" @bind="windowEnd" aria-label="@Loc["Monitor.Window.Hours"]" />
                </div>
                <p class="muted window-hint">@Loc["Monitor.Window.Hint"]</p>
            </div>

            <label class="recovery-choice">
                <input type="checkbox" class="recovery-check" @bind="notifyRecovery" />
                <span>@Loc["Monitor.Recovery.Label"]</span>
            </label>

            <div class="row">
                <button class="btn-sm" @onclick="SaveAsync" disabled="@busy">@Loc["Common.Save"]</button>
                @if (MonitorOf(selected.Id) is { } existing)
                {
                    @if (existing.Enabled)
                    {
                        <button class="btn-ghost btn-sm" @onclick="() => SetEnabledAsync(false)" disabled="@busy">@Loc["Monitor.Disable"]</button>
                    }
                    else
                    {
                        <button class="btn-ghost btn-sm" @onclick="() => SetEnabledAsync(true)" disabled="@busy">@Loc["Monitor.Enable"]</button>
                    }
                }
                <button class="btn-ghost btn-sm" @onclick="CloseEditor" disabled="@busy">@Loc["Common.Cancel"]</button>
            </div>

            @if (MonitorOf(selected.Id) is { } snoozable)
            {
                <div class="field snooze-field">
                    <label for="kw-monitor-snooze">@Loc["Monitor.Snooze.Label"]</label>
                    <div class="inline-controls inline-wrap">
                        <input id="kw-monitor-snooze" type="datetime-local" class="auto-width" @bind="snoozeUntilLocal" />
                        <button class="btn-ghost btn-sm" @onclick="SnoozeAsync" disabled="@busy">@Loc["Monitor.Snooze.Set"]</button>
                        @if (snoozable.SnoozeUntil is not null)
                        {
                            <button class="btn-ghost btn-sm" @onclick="ClearSnoozeAsync" disabled="@busy">@Loc["Monitor.Snooze.Clear"]</button>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <div class="card list-card">
        <div class="list-head">
            <h3 class="monitor-title"><KeywardIcon Name="activity" Size="18" />@Loc["Monitor.Title"]</h3>
            <p class="muted monitor-desc">@Loc["Monitor.Desc"]</p>
        </div>
        <div class="list-rows">
            @foreach (var token in tokens.OrderBy(t => EnvironmentOrderOf(t.EnvironmentId)).ThenBy(t => t.Name))
            {
                var monitor = MonitorOf(token.Id);
                <div class="list-row" @onclick="() => OpenEditor(token)">
                    <KeywardIcon Name="ticket" Size="17" />
                    <span class="list-row-name">@token.Name</span>
                    <span class="badge">@EnvironmentNameOf(token.EnvironmentId)</span>
                    @StateBadge(monitor)
                    <span class="list-row-meta">
                        <span class="muted row-facts">
                            @(token.LastAccessAt is { } lastAccess
                                ? Loc["Token.LastAccess.Value", Time.Format(lastAccess, TimeFormat)]
                                : Loc["Token.LastAccess.Never"])
                            @if (monitor is { Enabled: true })
                            {
                                @if (monitor.State == TokenMonitorState.Down && monitor.LastStateChangeAt is { } downSince)
                                {
                                    <text> · </text>@Loc["Monitor.DownSince", Time.Format(downSince, TimeFormat)]
                                    <text> (</text>@Loc["Monitor.Rel.Overdue", FormatDuration(DateTimeOffset.UtcNow - downSince)]<text>)</text>
                                }
                                else if (monitor.NextDeadline is { } deadline)
                                {
                                    <text> · </text>@Loc["Monitor.NextDeadline", Time.Format(deadline, TimeFormat)]
                                    <text> (</text>@(deadline > DateTimeOffset.UtcNow
                                        ? Loc["Monitor.Rel.In", FormatDuration(deadline - DateTimeOffset.UtcNow)]
                                        : Loc["Monitor.Rel.Overdue", FormatDuration(DateTimeOffset.UtcNow - deadline)])<text>)</text>
                                }
                            }
                        </span>
                        <KeywardIcon Name="chevron-right" Size="16" />
                    </span>
                </div>
            }
        </div>
    </div>

    @if (status is not null)
    {
        <div class="notice status-notice @(status.Value.IsError ? "notice-error" : "")" role="@(status.Value.IsError ? "alert" : "status")">
            @status.Value.Text
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public Guid TenantId { get; set; }
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter] public Guid? ActorUserId { get; set; }

    private const string TimeFormat = "yyyy-MM-dd HH:mm:ss";

    private Guid loadedProjectId;
    private System.Threading.Timer? relativeTimeTicker;

    private IReadOnlyList<EnvironmentInfo>? environments;
    private IReadOnlyList<SoftwareClientTokenInfo>? tokens;
    private IReadOnlyList<TokenMonitorInfo>? monitors;

    private Guid? selectedTokenId;

    // The shortest allowed silence this installation can resolve (minutes); the service refuses anything shorter.
    private int MinimumSilenceMinutes => MonitorService.MinimumMaxSilenceMinutes;
    private int silenceValue = 26;
    private string silenceUnit = "h";
    private readonly bool[] dayFlags = [true, true, true, true, true, true, true];
    private TimeOnly? windowStart;
    private TimeOnly? windowEnd;
    private bool notifyRecovery = true;
    private DateTime? snoozeUntilLocal;

    private (string Text, bool IsError)? status;
    private bool busy;

    private SoftwareClientTokenInfo? SelectedToken =>
        selectedTokenId is { } id ? tokens?.FirstOrDefault(t => t.Id == id) : null;

    protected override void OnInitialized()
    {
        Time.Changed += OnTimeZoneResolved;
        // The relative durations ("in 2 h" / "overdue by 45 min") go stale — refresh once a minute.
        relativeTimeTicker = new System.Threading.Timer(
            _ => _ = InvokeAsync(StateHasChanged), null, TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));
    }

    private void OnTimeZoneResolved() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Time.Changed -= OnTimeZoneResolved;
        relativeTimeTicker?.Dispose();
    }

    // Compact, language-neutral duration (units min/h/d), for the relative hints next to the deadlines.
    private static string FormatDuration(TimeSpan span)
    {
        span = span.Duration();
        if (span.TotalMinutes < 1)
        {
            return "< 1 min";
        }
        if (span.TotalHours < 1)
        {
            return $"{(int)span.TotalMinutes} min";
        }
        if (span.TotalDays < 1)
        {
            return span.Minutes == 0 ? $"{(int)span.TotalHours} h" : $"{(int)span.TotalHours} h {span.Minutes} min";
        }
        return span.Hours == 0 ? $"{(int)span.TotalDays} d" : $"{(int)span.TotalDays} d {span.Hours} h";
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ProjectId != loadedProjectId)
        {
            loadedProjectId = ProjectId;
            selectedTokenId = null;
            status = null;
            try
            {
                await LoadAsync(ProjectId);
            }
            catch (Exception ex)
            {
                status = (UserFacingError.Describe(ex, Loc, Logger), true);
            }
        }
    }

    private async Task LoadAsync(Guid projectId)
    {
        var loadedEnvironments = await SecretService.ListEnvironmentsAsync(TenantId, projectId);
        var loadedTokens = await TokenService.ListAsync(TenantId, projectId);
        var loadedMonitors = await MonitorService.ListAsync(TenantId, projectId);
        if (projectId != loadedProjectId)
        {
            return; // another application was picked meanwhile; its own load wins
        }

        environments = loadedEnvironments;
        tokens = loadedTokens;
        monitors = loadedMonitors;
    }

    private TokenMonitorInfo? MonitorOf(Guid tokenId) => monitors?.FirstOrDefault(m => m.TokenId == tokenId);

    private string EnvironmentNameOf(Guid environmentId) =>
        environments?.FirstOrDefault(e => e.Id == environmentId)?.Name ?? "?";

    // Position in the service-provided list, which is ordered by the environments' display order.
    private int EnvironmentOrderOf(Guid environmentId)
    {
        var index = environments is null ? -1 : environments.ToList().FindIndex(e => e.Id == environmentId);
        return index < 0 ? int.MaxValue : index;
    }

    // Monday-first (ISO) day labels from the current UI culture — no resource keys needed.
    private static string DayLabel(int mondayBasedIndex)
    {
        var names = CultureInfo.CurrentUICulture.DateTimeFormat.AbbreviatedDayNames;
        return names[((mondayBasedIndex + 1) % 7)];
    }

    private RenderFragment StateBadge(TokenMonitorInfo? monitor) => builder =>
    {
        var (css, key) = monitor switch
        {
            null => ("badge", "Monitor.State.Off"),
            { Enabled: false } => ("badge", "Monitor.State.Off"),
            { SnoozeUntil: { } until } when until > DateTimeOffset.UtcNow => ("badge badge-warning", "Monitor.State.Snoozed"),
            { State: TokenMonitorState.Down } => ("badge badge-danger", "Monitor.State.Down"),
            _ => ("badge badge-success", "Monitor.State.Up"),
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", css);
        builder.AddContent(2, Loc[key].Value);
        builder.CloseElement();
    };

    private void OpenEditor(SoftwareClientTokenInfo token)
    {
        selectedTokenId = token.Id;
        status = null;

        if (MonitorOf(token.Id) is { } monitor)
        {
            (silenceValue, silenceUnit) = monitor.MaxSilenceMinutes switch
            {
                var m when m % 1440 == 0 => (m / 1440, "d"),
                var m when m % 60 == 0 => (m / 60, "h"),
                var m => (m, "m"),
            };
            for (var i = 0; i < 7; i++)
            {
                dayFlags[i] = (monitor.WatchDaysMask & (1 << i)) != 0;
            }

            windowStart = monitor.WatchStart;
            windowEnd = monitor.WatchEnd;
            notifyRecovery = monitor.NotifyOnRecovery;
        }
        else
        {
            // Fresh defaults: a daily job with a 2 h buffer, watched every day, all-clear mail on.
            silenceValue = 26;
            silenceUnit = "h";
            Array.Fill(dayFlags, true);
            windowStart = null;
            windowEnd = null;
            notifyRecovery = true;
        }

        snoozeUntilLocal = null;
    }

    private void CloseEditor()
    {
        selectedTokenId = null;
        status = null;
    }

    private async Task SaveAsync()
    {
        if (busy || SelectedToken is not { } token)
        {
            return;
        }

        byte mask = 0;
        for (var i = 0; i < 7; i++)
        {
            if (dayFlags[i]) { mask |= (byte)(1 << i); }
        }

        if (windowStart.HasValue != windowEnd.HasValue)
        {
            status = (Loc["Monitor.Error.WindowIncomplete"].Value, true);
            return;
        }

        var minutes = silenceUnit switch { "d" => silenceValue * 1440, "h" => silenceValue * 60, _ => silenceValue };
        if (minutes < MinimumSilenceMinutes)
        {
            status = (Loc["Monitor.Error.SilenceTooShort", MinimumSilenceMinutes].Value, true);
            return;
        }

        busy = true;
        try
        {
            await MonitorService.UpsertAsync(new UpsertTokenMonitorCommand(
                TenantId, token.Id, minutes, mask, windowStart, windowEnd, notifyRecovery, ActorUserId));
            monitors = await MonitorService.ListAsync(TenantId, ProjectId);
            status = (Loc["Monitor.Saved"].Value, false);
        }
        catch (Exception ex)
        {
            status = (UserFacingError.Describe(ex, Loc, Logger), true);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SetEnabledAsync(bool enabled)
    {
        if (busy || SelectedToken is not { } token)
        {
            return;
        }

        busy = true;
        try
        {
            await MonitorService.SetEnabledAsync(TenantId, token.Id, enabled, ActorUserId);
            monitors = await MonitorService.ListAsync(TenantId, ProjectId);
            status = (Loc["Monitor.Saved"].Value, false);
        }
        catch (Exception ex)
        {
            status = (UserFacingError.Describe(ex, Loc, Logger), true);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SnoozeAsync()
    {
        if (busy || SelectedToken is not { } token || snoozeUntilLocal is not { } until)
        {
            return;
        }

        busy = true;
        try
        {
            // The datetime-local input is interpreted in the viewer's time zone, matching every
            // timestamp this panel shows (store UTC, display local).
            await MonitorService.SnoozeAsync(TenantId, token.Id, Time.ToUtc(until), ActorUserId);
            monitors = await MonitorService.ListAsync(TenantId, ProjectId);
            status = (Loc["Monitor.Saved"].Value, false);
        }
        catch (Exception ex)
        {
            status = (UserFacingError.Describe(ex, Loc, Logger), true);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ClearSnoozeAsync()
    {
        if (busy || SelectedToken is not { } token)
        {
            return;
        }

        busy = true;
        try
        {
            await MonitorService.SnoozeAsync(TenantId, token.Id, null, ActorUserId);
            monitors = await MonitorService.ListAsync(TenantId, ProjectId);
            status = (Loc["Monitor.Saved"].Value, false);
        }
        catch (Exception ex)
        {
            status = (UserFacingError.Describe(ex, Loc, Logger), true);
        }
        finally
        {
            busy = false;
        }
    }
}
