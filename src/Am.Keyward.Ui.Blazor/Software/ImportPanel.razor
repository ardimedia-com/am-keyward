@namespace Am.Keyward.Ui.Blazor.Software
@inject IApplicationImportService ImportService
@inject IStringLocalizer<SharedResource> Loc

@* Bulk import of applications + secret KEYS (never values), rendered in the Applications page's right
   pane. Two-step flow: Check parses the pasted text (indented list, JSON application map, or an
   appsettings.json whose leaf paths become the keys) and shows a diff preview against the current state;
   Import executes exactly that preview. Additive and idempotent: existing applications are reused,
   existing keys skipped — re-importing the same text is harmless. *@
<div class="card">
    <div class="row" style="justify-content:space-between;">
        <h3 style="margin:0; display:flex; align-items:center; gap:.5rem;"><KeywardIcon Name="upload" Size="18" />@Loc["Import.Title"]</h3>
        <button class="btn-ghost btn-sm" @onclick="OnClose" disabled="@busy"><KeywardIcon Name="x" Size="14" /> @Loc["Common.Close"]</button>
    </div>
    <p class="muted">@Loc["Import.Desc"]</p>
    <details class="help">
        <summary>@Loc["Common.HowItWorks"]</summary>
        <div><p style="white-space:pre-line;">@Loc["Import.Help"]</p></div>
    </details>

    <div class="field" style="margin-top:.75rem;">
        <label for="kw-import-source">@Loc["Import.Source"]</label>
        <textarea id="kw-import-source" rows="12" @bind="Source" @bind:event="oninput"
                  placeholder="@(Loc["Import.Placeholder"])" spellcheck="false" autocomplete="off"
                  style="font-family:ui-monospace,Consolas,monospace; white-space:pre; width:100%;"></textarea>
    </div>
    <div class="field" style="max-width:24rem;">
        <label for="kw-import-appname">@Loc["Import.AppName"]</label>
        <input id="kw-import-appname" @bind="TargetAppName" @bind:event="oninput" autocomplete="off"
               placeholder="@(Loc["Import.AppName.Placeholder"])" />
        <p class="muted" style="margin:.25rem 0 0; font-size:.8rem;">@Loc["Import.AppName.Hint"]</p>
    </div>

    <div class="row" style="margin-top:.75rem;">
        <button @onclick="CheckAsync" disabled="@(busy || string.IsNullOrWhiteSpace(source))"><KeywardIcon Name="search" Size="15" /> @Loc["Import.Check"]</button>
        <button @onclick="RunImportAsync" disabled="@(busy || !CanImport)"><KeywardIcon Name="upload" Size="15" /> @Loc["Import.Run"]</button>
        <button class="btn-ghost" @onclick="OnClose" disabled="@busy">@Loc["Common.Cancel"]</button>
    </div>

    @if (plan is { IsValid: false })
    {
        <div class="notice notice-error" style="margin-top:.75rem;" role="alert">
            <strong>@Loc["Import.Errors.Title"]</strong>
            <ul style="margin:.35rem 0 0; padding-left:1.25rem;">
                @foreach (var error in plan.Errors)
                {
                    <li>@(error.Line > 0 ? Loc["Import.Errors.Line", error.Line, error.Message] : error.Message)</li>
                }
            </ul>
        </div>
    }
    else if (preview is not null)
    {
        <div style="margin-top:.75rem;">
            <div class="list-head">
                <h3 style="margin:0;">@Loc["Import.Preview.Title"]</h3>
            </div>
            <p class="muted" style="margin:.25rem 0 .5rem;">
                @(CanImport
                    ? Loc["Import.Preview.Summary", preview.NewApplications, preview.NewKeys, preview.SkippedKeys]
                    : Loc["Import.Preview.Empty"])
            </p>
            <div class="list-rows">
                @foreach (var application in preview.Applications)
                {
                    <div class="list-row" style="cursor:default;">
                        <KeywardIcon Name="package" Size="17" />
                        <span class="list-row-name">@application.Name</span>
                        <span class="list-row-meta">
                            <span class="badge">@(application.Exists ? Loc["Import.Badge.Exists"] : Loc["Import.Badge.New"])</span>
                        </span>
                    </div>
                    @foreach (var key in application.Keys)
                    {
                        <div class="list-row" style="cursor:default; padding-left:1.75rem;">
                            <KeywardIcon Name="key" Size="15" />
                            <span class="list-row-name"><code>@key.Key</code></span>
                            <span class="list-row-meta">
                                <span class="badge">@(key.Exists ? Loc["Import.Badge.Skip"] : Loc["Import.Badge.New"])</span>
                            </span>
                        </div>
                    }
                }
            </div>
        </div>
    }

    @if (status is not null)
    {
        <div class="notice @(status.Value.IsError ? "notice-error" : "")" style="margin-top:.75rem;" role="@(status.Value.IsError ? "alert" : "status")">@status.Value.Text</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid TenantId { get; set; }
    [Parameter] public Guid? ActorUserId { get; set; }

    /// <summary>Raised after a successful import with the localized result summary; the parent reloads.</summary>
    [Parameter] public EventCallback<string> OnImported { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private string source = "";
    private string targetAppName = "";
    private ApplicationImportPlan? plan;
    private ApplicationImportPreview? preview;
    private (string Text, bool IsError)? status;
    private bool busy;

    // Any edit invalidates a previously checked preview — Import may only run exactly what was shown.
    private string Source
    {
        get => source;
        set { source = value; ResetCheck(); }
    }

    private string TargetAppName
    {
        get => targetAppName;
        set { targetAppName = value; ResetCheck(); }
    }

    private bool CanImport =>
        plan is { IsValid: true } && preview is not null && (preview.NewApplications > 0 || preview.NewKeys > 0);

    private void ResetCheck()
    {
        plan = null;
        preview = null;
        status = null;
    }

    private Task CheckAsync() => RunAsync(async () =>
    {
        preview = null;
        plan = ApplicationImportParser.Parse(source, targetAppName);
        if (plan.IsValid)
        {
            preview = await ImportService.PreviewAsync(TenantId, plan);
        }
    }, !string.IsNullOrWhiteSpace(source));

    private Task RunImportAsync() => RunAsync(async () =>
    {
        var result = await ImportService.ImportAsync(TenantId, plan!, ActorUserId);
        var summary = Loc["Import.Msg.Done", result.ApplicationsCreated, result.SecretsCreated, result.SecretsSkipped];
        await OnImported.InvokeAsync(summary);
    }, CanImport);

    private async Task RunAsync(Func<Task> action, bool precondition)
    {
        if (busy || !precondition) return;
        busy = true;
        status = null;
        try { await action(); }
        catch (Exception ex) { status = (Loc["Common.Error"] + ex.Message, true); }
        finally { busy = false; }
    }
}
