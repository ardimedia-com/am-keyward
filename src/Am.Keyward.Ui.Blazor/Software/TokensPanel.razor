@namespace Am.Keyward.Ui.Blazor.Software
@inject ISoftwareClientTokenService TokenService
@inject ISoftwareSecretService SecretService
@inject IStringLocalizer<SharedResource> Loc
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject BrowserTimeService Time
@inject ILogger<TokensPanel> Logger
@implements IDisposable
@inject KeywardUiOptions KeywardOptions

@* Client tokens for ONE application, rendered inside the Applications page's «Client-Tokens» tab. ONE ROW
   PER ENVIRONMENT: the model auto-creates a pending token slot per environment, so the natural unit is the
   environment. Each row shows the environment's token status and its primary action (Ausstellen / Rotieren /
   Widerrufen / Reaktivieren); selecting a row reveals its details (name/note, prefix, dates, delete) and the
   freshly minted secret — shown exactly once, under its own row. Reloads when ProjectId changes. *@
@if (environments is null || tokens is null)
{
    @if (status is { IsError: true } loadError)
    {
        <div class="notice notice-error" role="alert">@loadError.Text</div>
    }
    else
    {
        <p class="muted">@Loc["Common.Loading"]</p>
    }
}
else if (environments.Count == 0)
{
    <div class="card">
        <div class="empty-state">
            <KeywardIcon Name="ticket" Size="28" />
            <p>@Loc["Token.NoEnvironments"]</p>
        </div>
    </div>
}
else
{
    <div class="card list-card">
        <div class="list-head">
            <h3 class="tokens-title"><KeywardIcon Name="ticket" Size="18" />@Loc["App.Tab.Tokens"]</h3>
            <p class="muted tokens-desc">@Loc["Token.PerEnvHint"]</p>
        </div>
        <div class="list-rows">
            @foreach (var env in environments)
            {
                var token = TokenFor(env.Id);
                var selected = token is not null && token.Id == selectedTokenId;
                <div class="list-row @(token is null ? "list-row-static" : null)" @onclick="() => { if (token is not null) SelectToken(token.Id); }">
                    <KeywardIcon Name="layers" Size="17" />
                    <span class="list-row-name">@env.Name</span>
                    <span class="list-row-meta" @onclick:stopPropagation="true">
                        @if (token is null)
                        {
                            <span class="badge">@Loc["Token.Status.None"]</span>
                            @ExpirySelect()
                            <button class="btn-sm" @onclick="() => IssueForAsync(env.Name)" disabled="@busy"><KeywardIcon Name="plus" Size="14" />@Loc["Token.Issue.Action"]</button>
                        }
                        else
                        {
                            <span class="badge @StatusBadge(token)">@StatusOf(token)</span>
                            @if (token.HasSecret && token.RevokedAt is null)
                            {
                                <code class="token-prefix">@token.TokenPrefix</code>
                            }
                            @* "Is this token in use?" at a glance — the signal that makes revoke/rotate safe. *@
                            @if (token.HasSecret)
                            {
                                <span class="muted row-facts" title="@Loc["Token.LastAccess"]">
                                    @(token.LastAccessAt is { } lastAccess
                                        ? Loc["Token.LastAccess.Value", Time.Format(lastAccess, "yyyy-MM-dd HH:mm:ss")]
                                        : Loc["Token.LastAccess.Never"])
                                </span>
                            }
                            @if (token.RevokedAt is not null)
                            {
                                <button class="btn-ghost btn-sm" @onclick="() => ReactivateAsync(token.Id)" disabled="@busy">@Loc["Token.Reactivate"]</button>
                            }
                            else if (!token.HasSecret)
                            {
                                @* Pending → mint its first value; the validity (or "never") is chosen here. *@
                                @ExpirySelect()
                                <button class="btn-sm" @onclick="() => MintAsync(token.Id)" disabled="@busy">@Loc["Token.GenerateValue"]</button>
                            }
                            else
                            {
                                @* Rotate keeps the current lifetime unless a new validity is chosen. *@
                                @ExpirySelect(withKeep: true)
                                <button class="btn-ghost btn-sm" @onclick="() => RotateAsync(token.Id)" disabled="@busy">@Loc["Token.Rotate"]</button>
                                <button class="btn-danger btn-sm" @onclick="() => { SelectToken(token.Id); confirmRevoke = true; }" disabled="@busy">@Loc["Token.Revoke"]</button>
                            }
                            <KeywardIcon Name="chevron-right" Size="15" />
                        }
                    </span>
                </div>

                @if (selected && token is not null)
                {
                    <div class="card token-detail">
                        <div class="row detail-head">
                            <div class="row edit-row">
                                <KeywardIcon Name="ticket" Size="18" />
                                <input @bind="editName" aria-label="@(Loc["Common.Name"])" placeholder="@(Loc["Common.Name"])" title="@(Loc["Common.Name"])" class="edit-name" />
                                <input @bind="editNote" aria-label="@(Loc["Common.Note"])" placeholder="@(Loc["Token.NoteOptional"])" title="@(Loc["Token.NoteOptional"])" class="edit-note" />
                                <button class="btn-ghost btn-sm" @onclick="SaveEditAsync" disabled="@(busy || string.IsNullOrWhiteSpace(editName))">@Loc["Common.Save"]</button>
                            </div>
                            <div class="row">
                                <button class="btn-danger btn-sm" @onclick="() => confirmDelete = true" disabled="@busy">@Loc["Common.DeleteEllipsis"]</button>
                            </div>
                        </div>
                        @if (confirmRevoke)
                        {
                            <div class="notice notice-error detail-notice">
                                @Loc["Token.ConfirmRevoke", token.Name]
                                <button class="btn-danger btn-sm confirm-yes" @onclick="() => RevokeAsync(token.Id)" disabled="@busy">@Loc["Common.Yes"]</button>
                                <button class="btn-ghost btn-sm" @onclick="() => confirmRevoke = false">@Loc["Common.Cancel"]</button>
                            </div>
                        }
                        @if (confirmDelete)
                        {
                            <div class="notice notice-error detail-notice">
                                @Loc["Token.ConfirmDelete", token.Name]
                                <button class="btn-danger btn-sm confirm-yes" @onclick="() => DeleteAsync(token.Id)" disabled="@busy">@Loc["Common.Yes"]</button>
                                <button class="btn-ghost btn-sm" @onclick="() => confirmDelete = false">@Loc["Common.Cancel"]</button>
                            </div>
                        }
                        <div class="detail-grid token-facts">
                            <div class="detail-field">
                                <span class="detail-label">@Loc["Token.Prefix"]</span>
                                <div class="detail-value"><span class="grow">@if (token.HasSecret) { <code>@token.TokenPrefix</code> } else { <text>—</text> }</span></div>
                            </div>
                            <div class="detail-field">
                                <span class="detail-label">@Loc["Token.Created"]</span>
                                <div class="detail-value"><span class="grow"><LocalTime Utc="token.CreatedAt" /></span></div>
                            </div>
                            <div class="detail-field">
                                <span class="detail-label">@Loc["Token.Expires"]</span>
                                <div class="detail-value"><span class="grow"><LocalTime Utc="token.ExpiresAt" /></span></div>
                            </div>
                            <div class="detail-field">
                                <span class="detail-label">@Loc["Token.LastAccess"]</span>
                                <div class="detail-value"><span class="grow">
                                    @if (token.LastAccessAt is { } lastAccessAt)
                                    {
                                        <LocalTime Utc="lastAccessAt" />
                                        @if (token.LastAccessIp is { Length: > 0 } ip) { <text> · </text> <code>@ip</code> }
                                    }
                                    else { <text>—</text> }
                                </span></div>
                            </div>
                            @* T23 A: tokens of scripts and tools put every single read into the audit trail. *@
                            <div class="detail-field wide">
                                <label class="token-audit-reads">
                                    <input type="checkbox" checked="@token.AuditReads" @onchange="e => SetAuditReadsAsync(token.Id, e.Value is true)" disabled="@busy" />
                                    <span>@Loc["Token.AuditReads"] <span class="muted">— @Loc["Token.AuditReads.Hint"]</span></span>
                                </label>
                            </div>
                        </div>

                        @if (issuedToken is not null && issuedForTokenId == token.Id)
                        {
                            <div class="notice notice-reveal issued-notice" role="status">
                                @Loc["Token.New"] <span class="muted">@Loc["Common.ShownOnce.AutoClear"]</span>
                                <div class="row issued-row">
                                    <code class="issued-value">@issuedToken</code>
                                    <button class="icon-btn" title="@Loc["Common.Copy"]" aria-label="@Loc["Common.Copy"]" @onclick="CopyIssuedAsync"><KeywardIcon Name="@(issuedCopied ? "check" : "copy")" Size="15" /></button>
                                    <button class="btn-ghost btn-sm" @onclick="ClearIssued">@Loc["Common.Close"]</button>
                                </div>

                                @* Where the token goes decides how it is handed over (T39 A): a server or service reads it
                                   from a machine-wide environment variable; scripts on a person's computer read it through
                                   keyward, which asks for it hidden — so the second way never shows the token at all. *@
                                <div class="token-use">
                                    <KeywardTabBar Tabs="@UseTabs" Active="@useTab" ActiveChanged="@(t => useTab = t)">
                                        <ChildContent>
                                            <div class="token-use-head">
                                                <span class="muted">@(useTab == CliUse ? Loc["Token.Cli.Desc"] : Loc["Token.Use.Server.Desc"])</span>
                                                <button class="btn-ghost btn-sm" @onclick="CopyScriptAsync"><KeywardIcon Name="@(scriptCopied ? "check" : "copy")" Size="14" /> @Loc["Common.Copy"]</button>
                                            </div>
                                            @if (useTab == CliUse)
                                            {
                                                <pre class="kw-script">@CliSnippet()</pre>
                                                <p class="muted token-use-hint">@Loc["Token.Cli.Hint", Loc["Token.AuditReads"]]</p>
                                            }
                                            else
                                            {
                                                <pre class="kw-script">@PowerShellSnippet(token)</pre>
                                                <p class="muted token-use-hint">@Loc["Token.Ps.Hint", KeywardOptions.TokenVariableFor(ApplicationName)]</p>
                                            }
                                        </ChildContent>
                                    </KeywardTabBar>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>

    @if (status is not null)
    {
        <div class="notice @(status.Value.IsError ? "notice-error" : "")" role="@(status.Value.IsError ? "alert" : "status")">@status.Value.Text</div>
    }
}

@code {
    [Parameter, EditorRequired] public Guid TenantId { get; set; }
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }

    /// <summary>The application's name — the PowerShell snippet derives its env-variable name from it.</summary>
    [Parameter] public string ApplicationName { get; set; } = "";

    [Parameter] public Guid? ActorUserId { get; set; }

    /// <summary>A token to open (e.g. from the applications search); applied whenever <see cref="FocusRequest"/> changes.</summary>
    [Parameter] public Guid? FocusTokenId { get; set; }

    [Parameter] public int FocusRequest { get; set; }

    private int appliedFocus;

    private Guid loadedProjectId;

    private IReadOnlyList<EnvironmentInfo>? environments;
    private IReadOnlyList<SoftwareClientTokenInfo>? tokens;

    private Guid? selectedTokenId;
    private Guid? issuedForTokenId;
    private string? issuedToken;

    // The issued value is shown once and leaves the page again after SecretExposure.IssuedTokenVisible.
    private readonly DelayedAction issuedAutoClear = new();
    private bool issuedCopied;
    private bool scriptCopied;

    // The tab of the hand-over block next to a freshly issued token (server/service, or keyward on a computer).
    private const string ServerUse = "server";
    private const string CliUse = "keyward";
    private string useTab = ServerUse;

    private IReadOnlyList<KeywardTab> UseTabs =>
    [
        new(ServerUse, Loc["Token.Use.Server.Tab"], "server"),
        new(CliUse, Loc["Token.Use.Cli.Tab"], "terminal"),
    ];
    private bool confirmRevoke;
    private bool confirmDelete;
    private string editName = "";
    private string editNote = "";

    private (string Text, bool IsError)? status;
    private bool busy;

    // Token validity: the user chooses it when minting/issuing (days, or "never"); when rotating an active
    // token the default keeps the current lifetime unless a new window is chosen.
    private static readonly int[] ExpiryChoices = [1, 10, 30, 60, 90, 180, 360];
    private string mintExpiryChoice = "90";
    private string rotateExpiryChoice = "keep";

    private RenderFragment ExpirySelect(bool withKeep = false) => __builder =>
    {
        <select class="kw-expiry" value="@(withKeep ? rotateExpiryChoice : mintExpiryChoice)"
                @onchange="e => SetExpiryChoice(withKeep, e.Value?.ToString())"
                aria-label="@Loc["Token.ExpiresInDays"]" title="@Loc["Token.ExpiresInDays"]">
            @if (withKeep)
            {
                <option value="keep">@Loc["Token.Expires.Keep"]</option>
            }
            @foreach (var d in ExpiryChoices)
            {
                <option value="@d">@Loc["Token.Expires.Days", d]</option>
            }
            <option value="">@Loc["Token.Expires.Never"]</option>
        </select>
    };

    private void SetExpiryChoice(bool withKeep, string? value)
    {
        if (withKeep) { rotateExpiryChoice = value ?? "keep"; } else { mintExpiryChoice = value ?? "90"; }
    }

    // Mint (a rotation of a pending token): a number → that many days from now; "" → never.
    private TokenExpiryChange MintExpiry() =>
        int.TryParse(mintExpiryChoice, out var d) ? TokenExpiryChange.On(DateTimeOffset.UtcNow.AddDays(d)) : TokenExpiryChange.Never;

    // Issue (creating a fresh token): the same choice, but IssueAsync takes a nullable date (null = never).
    private DateTimeOffset? IssueExpiry() =>
        int.TryParse(mintExpiryChoice, out var d) ? DateTimeOffset.UtcNow.AddDays(d) : null;

    // Rotate: "keep" → keep the current window, a number → a fresh window, "" → never.
    private TokenExpiryChange RotateExpiry() =>
        rotateExpiryChoice == "keep" ? TokenExpiryChange.Keep
        : int.TryParse(rotateExpiryChoice, out var d) ? TokenExpiryChange.On(DateTimeOffset.UtcNow.AddDays(d))
        : TokenExpiryChange.Never;

    private SoftwareClientTokenInfo? TokenFor(Guid environmentId) =>
        tokens?.Where(t => t.EnvironmentId == environmentId).OrderByDescending(t => t.HasSecret).FirstOrDefault();

    // Timestamps inside localized strings can't use <LocalTime/> — refresh once the browser zone resolves.
    protected override void OnInitialized() => Time.Changed += OnTimeZoneResolved;

    private void OnTimeZoneResolved() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Time.Changed -= OnTimeZoneResolved;
        issuedAutoClear.Dispose();
        issuedToken = null;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ProjectId != loadedProjectId)
        {
            loadedProjectId = ProjectId;
            status = null;
            try
            {
                await LoadAsync(ProjectId);
            }
            catch (Exception ex)
            {
                status = (UserFacingError.Describe(ex, Loc, Logger), true);
            }
        }

        if (FocusRequest != appliedFocus)
        {
            appliedFocus = FocusRequest;
            if (FocusTokenId is { } tokenId && tokens?.Any(t => t.Id == tokenId) == true)
            {
                selectedTokenId = tokenId;
            }
        }
    }

    private async Task LoadAsync(Guid projectId)
    {
        selectedTokenId = null;
        ClearIssued();
        confirmRevoke = false;
        confirmDelete = false;
        var loadedEnvironments = await SecretService.ListEnvironmentsAsync(TenantId, projectId);
        var loadedTokens = await TokenService.ListAsync(TenantId, projectId);
        if (projectId != loadedProjectId)
        {
            return; // another application was picked meanwhile; its own load wins
        }

        environments = loadedEnvironments;
        tokens = loadedTokens;
    }

    private async Task RefreshAsync() =>
        tokens = await TokenService.ListAsync(TenantId, ProjectId);

    private void SelectToken(Guid tokenId)
    {
        if (issuedForTokenId is { } issuedId && issuedId != tokenId)
        {
            ClearIssued();
        }
        selectedTokenId = selectedTokenId == tokenId ? null : tokenId; // toggle
        confirmRevoke = false;
        confirmDelete = false;
        LoadEditFor(tokenId);
    }

    // The name/note inputs must be populated on EVERY path that opens the detail card — not only the
    // row click (SelectToken) but also mint/rotate/issue, which select the row programmatically.
    private void LoadEditFor(Guid tokenId)
    {
        var t = tokens?.FirstOrDefault(x => x.Id == tokenId);
        editName = t?.Name ?? "";
        editNote = t?.Note ?? "";
    }

    // No token for this environment yet (e.g. it was deleted): create + mint in one step.
    private Task IssueForAsync(string environmentName) => RunAsync(async () =>
    {
        var issued = await TokenService.IssueAsync(
            new IssueSoftwareClientTokenCommand(TenantId, ProjectId, environmentName, "", IssueExpiry(), ActorUserId, ""));
        ShowIssued(issued.Token, issued.TokenId);
        await RefreshAsync();
        selectedTokenId = issued.TokenId;
        LoadEditFor(issued.TokenId);
        status = (Loc["Token.Msg.Issued", environmentName, environmentName], false);
    }, true);

    // Mints the FIRST value of a pending placeholder (technically a rotation with an explicit expiry).
    private Task MintAsync(Guid tokenId) => RunAsync(async () =>
    {
        var minted = await TokenService.RotateAsync(TenantId, tokenId, MintExpiry(), ActorUserId);
        ShowIssued(minted.Token, tokenId);
        selectedTokenId = tokenId;
        await RefreshAsync();
        LoadEditFor(tokenId);
        status = (Loc["Token.Msg.Generated"], false);
    }, true);

    private Task RotateAsync(Guid tokenId) => RunAsync(async () =>
    {
        var rotated = await TokenService.RotateAsync(TenantId, tokenId, RotateExpiry(), ActorUserId);
        ShowIssued(rotated.Token, tokenId);
        selectedTokenId = tokenId;
        await RefreshAsync();
        LoadEditFor(tokenId);
        status = (Loc["Token.Msg.Rotated"], false);
    }, true);

    private Task RevokeAsync(Guid tokenId) => RunAsync(async () =>
    {
        await TokenService.RevokeAsync(TenantId, tokenId, ActorUserId);
        confirmRevoke = false;
        await RefreshAsync();
        status = (Loc["Token.Msg.Revoked"], false);
    }, true);

    private Task ReactivateAsync(Guid tokenId) => RunAsync(async () =>
    {
        await TokenService.ReactivateAsync(TenantId, tokenId, ActorUserId);
        await RefreshAsync();
        status = (Loc["Token.Msg.Reactivated"], false);
    }, true);

    private Task SaveEditAsync() => RunAsync(async () =>
    {
        await TokenService.UpdateAsync(TenantId, selectedTokenId!.Value, editName, editNote, ActorUserId);
        await RefreshAsync();
        status = (Loc["Token.Msg.Updated"], false);
    }, selectedTokenId is not null && !string.IsNullOrWhiteSpace(editName));

    private Task SetAuditReadsAsync(Guid tokenId, bool auditReads) => RunAsync(async () =>
    {
        await TokenService.SetAuditReadsAsync(TenantId, tokenId, auditReads, ActorUserId);
        await RefreshAsync();
        status = (Loc["Token.Msg.Updated"], false);
    }, true);

    private Task DeleteAsync(Guid tokenId) => RunAsync(async () =>
    {
        await TokenService.DeleteAsync(TenantId, tokenId, ActorUserId);
        confirmDelete = false;
        selectedTokenId = null;
        ClearIssued();
        await RefreshAsync();
        status = (Loc["Token.Msg.Deleted"], false);
    }, true);

    private void ShowIssued(string token, Guid tokenId)
    {
        issuedToken = token;
        issuedForTokenId = tokenId;
        issuedCopied = false;
        issuedAutoClear.Schedule(SecretExposure.IssuedTokenVisible, () => InvokeAsync(() =>
        {
            ClearIssued();
            StateHasChanged();
        }));
    }

    // Dismissed, timed out, another token selected, deleted or the application changed: the value leaves the page.
    private void ClearIssued()
    {
        issuedAutoClear.Cancel();
        issuedToken = null;
        issuedForTokenId = null;
        issuedCopied = false;
        scriptCopied = false;
    }

    private async Task CopyIssuedAsync()
    {
        if (issuedToken is null) return;
        if (!await JS.TryCopySecretToClipboardAsync(issuedToken)) return;
        issuedCopied = true;
        StateHasChanged();
        await Task.Delay(1500);
        issuedCopied = false;
    }

    /// <summary>
    /// The deployment step for the freshly issued token, as a PowerShell block the operator can paste on the
    /// target machine: the token in a variable (so the verification call below works in the SAME session —
    /// a machine-scope variable does not reach the current process), persisted machine-wide, then a call
    /// that proves the token can read this environment's secrets.
    /// </summary>
    private string PowerShellSnippet(SoftwareClientTokenInfo token)
    {
        var environmentName = environments?.FirstOrDefault(e => e.Id == token.EnvironmentId)?.Name ?? "";
        var baseUrl = (string.IsNullOrWhiteSpace(KeywardOptions.PublicBaseUrl) ? Nav.BaseUri : KeywardOptions.PublicBaseUrl!).TrimEnd('/');
        var url = $"{baseUrl}/{KeywardOptions.ClientApiBasePath.Trim('/')}/secrets";
        var variable = KeywardOptions.TokenVariableFor(ApplicationName);

        // $$ raw string: {{…}} interpolates, so PowerShell's own braces stay literal.
        return $$"""
            # {{KeywardOptions.ProductName}} — {{Loc["Token.Ps.Comment.Token", token.Name, environmentName]}}
            $token = '{{issuedToken}}'

            # {{Loc["Token.Ps.Comment.Current"]}}
            [Environment]::GetEnvironmentVariable('{{variable}}', 'Machine')

            # {{Loc["Token.Ps.Comment.Persist"]}}
            [Environment]::SetEnvironmentVariable('{{variable}}', $token, 'Machine')

            # {{Loc["Token.Ps.Comment.Verify"]}}
            Invoke-RestMethod -Uri '{{url}}' -Headers @{ Authorization = "Bearer $token" }
            """;
    }

    /// <summary>
    /// The keyward hand-over: install, store the token under a profile (keyward asks for it hidden, so it is
    /// deliberately NOT in this block), check, use. The profile name is a suggestion derived from the application.
    /// </summary>
    private string CliSnippet()
    {
        var baseUrl = (string.IsNullOrWhiteSpace(KeywardOptions.PublicBaseUrl) ? Nav.BaseUri : KeywardOptions.PublicBaseUrl!).TrimEnd('/');
        var profile = CliProfileFor(ApplicationName);
        return $$"""
            # {{KeywardOptions.ProductName}} — {{Loc["Token.Cli.Comment.Install"]}}
            dotnet tool install --global Am.Keyward.Cli --prerelease

            # {{Loc["Token.Cli.Comment.Login", profile]}}
            keyward login {{profile}} --service {{baseUrl}}

            # {{Loc["Token.Cli.Comment.Check"]}}
            keyward keys {{profile}}

            # {{Loc["Token.Cli.Comment.Use"]}}
            keyward get {{profile}}:<Key>
            keyward run --env NAME={{profile}}:<Key> -- <program>
            """;
    }

    // keyward profile names allow letters, digits, «-», «_» and «.» (lower case).
    private static string CliProfileFor(string applicationName)
    {
        var profile = new string(applicationName.Trim().ToLowerInvariant()
            .Select(c => char.IsLetterOrDigit(c) || c is '-' or '_' or '.' ? c : '-').ToArray()).Trim('-', '.');
        return profile.Length == 0 ? "app" : profile;
    }

    private async Task CopyScriptAsync()
    {
        var token = tokens?.FirstOrDefault(t => t.Id == issuedForTokenId);
        if (issuedToken is null || token is null) return;
        // The PowerShell block carries the token itself, so it is copied (and later cleared) like a secret; the
        // keyward block deliberately does not contain it.
        var copied = useTab == CliUse
            ? await JS.TryCopyToClipboardAsync(CliSnippet())
            : await JS.TryCopySecretToClipboardAsync(PowerShellSnippet(token));
        if (!copied) return;
        scriptCopied = true;
        StateHasChanged();
        await Task.Delay(1500);
        scriptCopied = false;
    }

    private string StatusOf(SoftwareClientTokenInfo token) =>
        token.RevokedAt is not null ? Loc["Token.Status.Revoked"]
        : !token.HasSecret ? Loc["Token.Status.Pending"]
        : token.IsActive ? Loc["Token.Status.Active"]
        : Loc["Token.Status.Expired"];

    private static string StatusBadge(SoftwareClientTokenInfo token) =>
        token.RevokedAt is not null ? "badge-danger"
        : !token.HasSecret ? ""
        : token.IsActive ? "badge-success"
        : "badge-warning";

    private async Task RunAsync(Func<Task> action, bool precondition)
    {
        if (busy || !precondition) return;
        busy = true;
        status = null;
        try { await action(); }
        catch (Exception ex) { status = (UserFacingError.Describe(ex, Loc, Logger), true); }
        finally { busy = false; }
    }
}
