@implements IAsyncDisposable
@inject IJSRuntime JS
@inject BrowserTimeService Time

@* Style scope for the embedded Keyward UI. Wrap a Keyward page's content in <KeywardUi>...</KeywardUi>;
   the styling lives in KeywardUi.razor.css and — because it is component-scoped CSS in this RCL — is
   bundled automatically into the host app's {Assembly}.styles.css. A host therefore needs NO extra <link>:
   referencing the standard Blazor styles bundle is enough. Override the look via the --kw-* CSS variables.
   Fill: the page header/search stay put and the workspace panes scroll internally (vault pages) — the host
   opts its scroll container in via CSS (see the .kw-fill rules in the reference shell's app.css). *@
<div class="keyward-ui @(Fill ? "kw-fill" : "")">@ChildContent</div>

@* Built-in toast host for the DEFAULT notifier (standalone). Empty when a host routes IKeywardNotifier
   through its own toasts (e.g. BlazorBlueprint's BbToast). *@
<KeywardToastHost />

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Fills the host's content area: header + search stay fixed, tree/content scroll internally.</summary>
    [Parameter] public bool Fill { get; set; }

    private IJSObjectReference? module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Detect the browser time zone (once per circuit) so UTC timestamps render in local time.
        // Retry on every render until it resolves: a single attempt on the first interactive render can
        // miss if JS interop isn't ready yet, which would otherwise leave every timestamp stuck in UTC
        // for the whole session.
        if (Time.IsReady)
        {
            return;
        }
        try
        {
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Am.Keyward.Ui.Blazor/KeywardUi.razor.js");
            var ianaId = await module.InvokeAsync<string?>("getTimeZoneName");
            var offsetMinutes = await module.InvokeAsync<int>("getTimeZoneOffsetMinutes");
            Time.SetTimeZone(ianaId, offsetMinutes);
        }
        catch
        {
            // JS not available yet (prerender) or circuit tearing down — timestamps stay UTC until a later render.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone — nothing to release.
            }
        }
    }
}
