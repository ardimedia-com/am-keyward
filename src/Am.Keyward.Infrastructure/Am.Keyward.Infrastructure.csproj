<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Am.Keyward.Core\Am.Keyward.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SessionContextCommand is an implementation detail, but its NULL-omission behaviour guards against a
         production outage (KB4089324) and must be covered by tests without widening the public API. -->
    <InternalsVisibleTo Include="Am.Keyward.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <!-- Windows DPAPI, for the optional file-based KEK custody helper (DpapiKekFile / DpapiKekEscrow). The
         package restores everywhere; the helpers are [SupportedOSPlatform("windows")] and a host on another
         platform simply supplies its own IKekProvider instead. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <!-- Not used directly. Microsoft.Data.SqlClient 6.1.6 (via EF Core SqlServer) and MimeKit (via MailKit in the
         host) pull System.Security.Cryptography.Pkcs 9.0.11 / 10.0.0, both hit by CVE-2026-84008 (GHSA-846f-f764-76mx,
         high, denial of service; fixed in 10.0.13). This direct reference lifts every consumer of Infrastructure to
         a patched version. Remove it once SqlClient and MimeKit reference a patched Pkcs themselves. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>AM KEYWARD — EF Core (SQL Server) persistence, envelope crypto and KEK providers, tamper-evident audit, tenancy with row-level security, vaults, software-client tokens, break-glass and monitoring.</Description>
  </PropertyGroup>

</Project>
