{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Keyward": {
    "ProductName": "Beispiel AG Secrets Verwaltung",
    "NotificationLanguage": "de",
    "Registration": {
      "Mode": "InviteOnly",
      "InvitationLifetimeHours": 48
    }
  },
  "DatabaseMigration": {
    "Enabled": true,
    "CheckIntervalSeconds": 60
  },
  "AccountEmail": {
    "MaildropPath": ""
  }
}
