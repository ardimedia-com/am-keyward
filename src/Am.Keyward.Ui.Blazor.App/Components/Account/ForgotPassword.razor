@page "/account/forgot-password"
@using System.ComponentModel.DataAnnotations
@using System.Diagnostics
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@inject UserManager<IdentityUser> UserManager
@inject IAccountEmailSender EmailSender
@inject AccountLinkBuilder Links
@inject ILogger<ForgotPassword> Logger
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@KeywardOptions.ProductName</PageTitle>

<h1>@Loc["Reset.Forgot.Title"]</h1>
<p>@Loc["Reset.Forgot.Desc"]</p>

@if (submitted)
{
    <div class="notice" role="status">@Loc["Reset.Forgot.Sent"]</div>
}
else
{
    <EditForm Model="Input" method="post" OnValidSubmit="SendAsync" FormName="forgot">
        <DataAnnotationsValidator />
        <div style="display:flex; flex-direction:column; gap:.5rem; max-width:24rem;">
            <label>@Loc["Login.Email"]
                <InputText @bind-Value="Input.Email" autocomplete="username" />
            </label>
            <ValidationSummary />
            <button type="submit">@Loc["Reset.Forgot.Submit"]</button>
        </div>
    </EditForm>
}

<p><a href="account/login">@Loc["Register.SignInLink"]</a></p>

@code {
    [SupplyParameterFromForm] private InputModel Input { get; set; } = default!;

    private bool submitted;

    protected override void OnInitialized() => Input ??= new();

    private async Task SendAsync()
    {
        // Always the same confirmation after the same minimum time (no account enumeration): only an existing,
        // usable account actually gets a mail, and a delivery failure is logged, never shown.
        var started = Stopwatch.GetTimestamp();
        try
        {
            var user = await UserManager.FindByEmailAsync(Input.Email);
            // Not for a disabled account or a pending invitation (both hold LockoutEnd = MaxValue): a reset would
            // not let them in, and an invitee sets the first password through the invitation link.
            if (user is not null && !(user.LockoutEnd is { } end && end >= DateTimeOffset.MaxValue.AddDays(-1)))
            {
                var token = await UserManager.GeneratePasswordResetTokenAsync(user);
                var link = Links.Build("account/reset-password", new Dictionary<string, string?>
                {
                    ["email"] = Input.Email,
                    ["token"] = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(token)),
                }, Nav.BaseUri);
                await EmailSender.SendPasswordResetLinkAsync(Input.Email, link);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to send the password-reset e-mail to {Email}.", Input.Email);
        }
        finally
        {
            await AccountResponseTiming.EnsureFloorAsync(started);
        }

        submitted = true;
    }

    private sealed class InputModel
    {
        [Required, EmailAddress]
        public string Email { get; set; } = "";
    }
}
