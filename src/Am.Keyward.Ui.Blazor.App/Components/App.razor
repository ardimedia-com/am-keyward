@using System.Globalization
@using Am.Keyward.Ui.Blazor.App.Hosting
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* Applies the per-browser theme before first paint. A file, not an inline script: the Content-Security-Policy
       admits scripts only from this origin or with the request's nonce. *@
    <script src="@Assets["js/keyward-theme-init.js"]"></script>
    <title>@KeywardOptions.ProductName</title>
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    @* The Keyward RCL's component-scoped CSS is bundled into this app styles bundle automatically. *@
    <link rel="stylesheet" href="@Assets["Am.Keyward.Ui.Blazor.App.styles.css"]" />
    @* The import map is the one inline script; it carries the CSP nonce of this request. *@
    <ImportMap nonce="@Nonce" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["js/keyward-theme.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? Nonce => HttpContext is null ? null : SecurityHeaders.GetNonce(HttpContext);
}
