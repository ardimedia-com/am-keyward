@page "/Error"
@using System.Diagnostics
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@KeywardOptions.ProductName</PageTitle>

<h1 style="color:var(--danger);">@Loc["Error.Title"]</h1>
<h2 style="color:var(--danger);">@Loc["Error.Heading"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@Loc["Error.RequestId"]</strong> <code>@RequestId</code>
    </p>
}

@* No "switch to Development" advice here: this page is only reached outside Development (Development shows the
   developer exception page), where it would only tell an end user how the installation is run. The request id
   above is what an operator needs to find the details in the log. *@

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
