<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>AM KEYWARD — .NET client for the software-client API: AddKeywardSecrets(...) loads an application's secrets straight into IConfiguration (bulk read, optional periodic reload), plus a typed KeywardSecretsClient for direct runtime reads via IHttpClientFactory. Talks plain HTTPS with a Bearer app token; no server-side dependencies.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- ConfigurationProvider base + builder extensions. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
    <!-- IHttpClientFactory registration for the typed runtime client (AddKeywardSecretsClient). -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <!-- ILogger on the best-effort heartbeat helper (explicit, not relied upon transitively via Http). -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Am.Keyward.Contracts\Am.Keyward.Contracts.csproj" />
  </ItemGroup>

</Project>
